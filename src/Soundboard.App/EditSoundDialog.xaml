<Window x:Class="Soundboard.App.EditSoundDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit sound"
        Icon="Assets/Soundboard.ico"
        Width="540"
        Height="720"
        MinWidth="460"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="{StaticResource UiFontFamily}"
        FontSize="{StaticResource FontSizeBody}"
        Foreground="{StaticResource TextPrimaryBrush}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        TextOptions.TextFormattingMode="Ideal"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style x:Key="FieldLabelStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource SubtitleTextStyle}">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <!-- See SettingsWindow: DisplayMemberPath does not reach the collapsed ComboBox. -->
        <DataTemplate x:Key="CategoryChoiceTemplate">
            <TextBlock Text="{Binding DisplayName}"
                       TextTrimming="CharacterEllipsis" />
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="22,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource TitleTextStyle}"
                   Text="Edit sound" />

        <!-- Basic information -->
        <Border Grid.Row="1"
                Margin="0,16,0,0"
                Style="{StaticResource SurfacePanelStyle}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionHeadingTextStyle}"
                           Text="BASIC INFORMATION" />
                <TextBlock Style="{StaticResource FieldLabelStyle}"
                           Text="Display name" />
                <TextBox x:Name="NameTextBox"
                         MaxLength="120"
                         AutomationProperties.Name="Sound display name" />

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabelStyle}"
                                   Text="Category" />
                        <ComboBox x:Name="CategoryComboBox"
                                  ItemTemplate="{StaticResource CategoryChoiceTemplate}"
                                  AutomationProperties.Name="Sound category" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource FieldLabelStyle}"
                                   Text="Tile accent" />
                        <ComboBox x:Name="TileAccentComboBox"
                                  AutomationProperties.Name="Tile accent preset" />
                    </StackPanel>
                </Grid>

                <CheckBox x:Name="FavoriteCheckBox"
                          Margin="0,16,0,0"
                          Content="Favorite"
                          AutomationProperties.Name="Favorite sound" />

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="56" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabelStyle}"
                                   Text="Sound volume" />
                        <Slider x:Name="VolumeSlider"
                                Minimum="0"
                                Maximum="100"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                ValueChanged="VolumeSlider_ValueChanged"
                                AutomationProperties.Name="Per-sound volume percentage" />
                    </StackPanel>
                    <TextBlock x:Name="VolumeTextBlock"
                               Grid.Column="1"
                               Margin="10,22,0,0"
                               VerticalAlignment="Center"
                               TextAlignment="Right"
                               Text="100%" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- File information -->
        <Border Grid.Row="2"
                Margin="0,14,0,0"
                Style="{StaticResource SurfacePanelStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.ColumnSpan="2"
                           Style="{StaticResource SectionHeadingTextStyle}"
                           Text="FILE INFORMATION" />

                <TextBlock Grid.Row="1"
                           Style="{StaticResource SecondaryTextStyle}"
                           Text="Original filename" />
                <TextBlock x:Name="OriginalFileNameTextBlock"
                           Grid.Row="1"
                           Grid.Column="1"
                           TextWrapping="Wrap" />

                <TextBlock Grid.Row="2"
                           Margin="0,8,0,0"
                           Style="{StaticResource SecondaryTextStyle}"
                           Text="Duration" />
                <TextBlock x:Name="DurationTextBlock"
                           Grid.Row="2"
                           Grid.Column="1"
                           Margin="0,8,0,0" />

                <TextBlock Grid.Row="3"
                           Margin="0,8,0,0"
                           Style="{StaticResource SecondaryTextStyle}"
                           Text="Format" />
                <TextBlock x:Name="FormatTextBlock"
                           Grid.Row="3"
                           Grid.Column="1"
                           Margin="0,8,0,0" />

                <TextBlock Grid.Row="4"
                           Margin="0,8,0,0"
                           Style="{StaticResource SecondaryTextStyle}"
                           Text="Assigned hotkey" />
                <Border Grid.Row="4"
                        Grid.Column="1"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Left"
                        Style="{StaticResource KeyCapChipStyle}">
                    <TextBlock x:Name="HotkeyTextBlock"
                               Style="{StaticResource KeyCapTextStyle}" />
                </Border>
            </Grid>
        </Border>

        <TextBlock Grid.Row="3"
                   Margin="0,14,0,0"
                   VerticalAlignment="Top"
                   Style="{StaticResource MutedTextStyle}"
                   Text="Hotkeys are managed from the tile action menu. Saving metadata does not rename the managed audio file or interrupt playback." />

        <StackPanel Grid.Row="4"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button MinWidth="92"
                    Content="Cancel"
                    IsCancel="True"
                    Click="CancelButton_Click" />
            <Button Margin="10,0,0,0"
                    MinWidth="92"
                    Content="Save"
                    IsDefault="True"
                    Click="SaveButton_Click"
                    Style="{StaticResource PrimaryButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
