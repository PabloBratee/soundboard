<Window x:Class="Soundboard.App.EditSoundDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit sound"
        Width="510"
        Height="500"
        MinWidth="430"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock FontSize="19"
                   FontWeight="SemiBold"
                   Text="Edit sound" />

        <StackPanel Grid.Row="1"
                    Margin="0,16,0,0">
            <TextBlock FontWeight="SemiBold"
                       Text="Display name" />
            <TextBox x:Name="NameTextBox"
                     Margin="0,7,0,0"
                     MinHeight="32"
                     MaxLength="120"
                     VerticalContentAlignment="Center"
                     AutomationProperties.Name="Sound display name" />
        </StackPanel>

        <Grid Grid.Row="2"
              Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontWeight="SemiBold"
                           Text="Category" />
                <ComboBox x:Name="CategoryComboBox"
                          Margin="0,7,0,0"
                          MinHeight="32"
                          DisplayMemberPath="DisplayName"
                          AutomationProperties.Name="Sound category" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock FontWeight="SemiBold"
                           Text="Tile accent" />
                <ComboBox x:Name="TileAccentComboBox"
                          Margin="0,7,0,0"
                          MinHeight="32"
                          AutomationProperties.Name="Tile accent preset" />
            </StackPanel>
        </Grid>

        <CheckBox x:Name="FavoriteCheckBox"
                  Grid.Row="3"
                  Margin="0,16,0,0"
                  Content="Favorite"
                  AutomationProperties.Name="Favorite sound" />

        <Separator Grid.Row="4"
                   Margin="0,16,0,12" />

        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="125" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock FontWeight="SemiBold"
                       Text="Original filename" />
            <TextBlock x:Name="OriginalFileNameTextBlock"
                       Grid.Column="1"
                       TextWrapping="Wrap" />
            <TextBlock Grid.Row="1"
                       Margin="0,8,0,0"
                       FontWeight="SemiBold"
                       Text="Duration" />
            <TextBlock x:Name="DurationTextBlock"
                       Grid.Row="1"
                       Grid.Column="1"
                       Margin="0,8,0,0" />
            <TextBlock Grid.Row="2"
                       Margin="0,8,0,0"
                       FontWeight="SemiBold"
                       Text="Assigned hotkey" />
            <TextBlock x:Name="HotkeyTextBlock"
                       Grid.Row="2"
                       Grid.Column="1"
                       Margin="0,8,0,0" />
        </Grid>

        <TextBlock Grid.Row="6"
                   Margin="0,14,0,0"
                   Foreground="#596574"
                   Text="Hotkeys remain managed in the dedicated hotkey dialog. Saving metadata does not rename the managed audio file or interrupt playback."
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="7"
                    Margin="0,18,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button MinWidth="88"
                    Padding="10,5"
                    IsCancel="True"
                    Click="CancelButton_Click"
                    Content="Cancel" />
            <Button Margin="9,0,0,0"
                    MinWidth="88"
                    Padding="10,5"
                    IsDefault="True"
                    Click="SaveButton_Click"
                    Content="Save" />
        </StackPanel>
    </Grid>
</Window>
