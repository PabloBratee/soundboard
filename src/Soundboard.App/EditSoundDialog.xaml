<Window x:Class="Soundboard.App.EditSoundDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit sound"
        Icon="Assets/Soundboard.ico"
        Width="520"
        SizeToContent="Height"
        MinWidth="460"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="{StaticResource UiFontFamily}"
        FontSize="{StaticResource FontSizeBody}"
        Foreground="{StaticResource TextPrimaryBrush}"
        PreviewKeyDown="EditSoundDialog_PreviewKeyDown"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        TextOptions.TextFormattingMode="Ideal"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style x:Key="FieldLabelStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource CaptionTextStyle}">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        </Style>
        <!-- See SettingsWindow: DisplayMemberPath does not reach the collapsed ComboBox. -->
        <DataTemplate x:Key="CategoryChoiceTemplate">
            <TextBlock Text="{Binding DisplayName}"
                       TextTrimming="CharacterEllipsis" />
        </DataTemplate>
        <Style x:Key="FileFactLabelStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource MutedTextStyle}">
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
    </Window.Resources>

    <Grid Margin="20,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Style="{StaticResource TitleTextStyle}"
                       Text="Edit sound" />
            <TextBlock Margin="0,3,0,0"
                       Style="{StaticResource MutedTextStyle}"
                       Text="Category, favorites, and ordering can also be changed straight from the library." />
        </StackPanel>

        <!-- Identity -->
        <Border Grid.Row="1"
                Margin="0,14,0,0"
                Padding="14"
                Style="{StaticResource SurfacePanelStyle}">
            <StackPanel>
                <TextBlock Style="{StaticResource FieldLabelStyle}"
                           Text="Display name" />
                <TextBox x:Name="NameTextBox"
                         MaxLength="120"
                         TextChanged="EditField_Changed"
                         AutomationProperties.Name="Sound display name" />

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabelStyle}"
                                   Text="Category" />
                        <ComboBox x:Name="CategoryComboBox"
                                  ItemTemplate="{StaticResource CategoryChoiceTemplate}"
                                  MaxDropDownHeight="220"
                                  SelectionChanged="EditField_Changed"
                                  AutomationProperties.Name="Sound category" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource FieldLabelStyle}"
                                   Text="Tile accent" />
                        <ComboBox x:Name="TileAccentComboBox"
                                  MaxDropDownHeight="220"
                                  SelectionChanged="EditField_Changed"
                                  AutomationProperties.Name="Tile accent preset" />
                    </StackPanel>
                </Grid>

                <CheckBox x:Name="FavoriteCheckBox"
                          Margin="0,14,0,0"
                          Checked="EditField_Changed"
                          Unchecked="EditField_Changed"
                          Content="Show in Favorites"
                          AutomationProperties.Name="Favorite sound" />
            </StackPanel>
        </Border>

        <!-- Playback -->
        <Border Grid.Row="2"
                Margin="0,10,0,0"
                Padding="14"
                Style="{StaticResource SurfacePanelStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                               Text="Sound volume" />
                    <Slider x:Name="VolumeSlider"
                            Minimum="0"
                            Maximum="100"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            ValueChanged="VolumeSlider_ValueChanged"
                            AutomationProperties.Name="Per-sound volume percentage" />
                </StackPanel>
                <TextBlock x:Name="VolumeTextBlock"
                           Grid.Column="1"
                           Width="46"
                           Margin="12,16,0,0"
                           VerticalAlignment="Center"
                           TextAlignment="Right"
                           Text="100%" />
            </Grid>
        </Border>

        <!-- File information -->
        <Border Grid.Row="3"
                Margin="0,10,0,0"
                Padding="14"
                Style="{StaticResource SurfacePanelStyle}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionHeadingTextStyle}"
                           Margin="0,0,0,6"
                           Text="FILE" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource FileFactLabelStyle}"
                                   Text="Original filename" />
                        <TextBlock x:Name="OriginalFileNameTextBlock"
                                   Margin="0,0,12,0"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,18,0">
                        <TextBlock Style="{StaticResource FileFactLabelStyle}"
                                   Text="Duration" />
                        <TextBlock x:Name="DurationTextBlock" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource FileFactLabelStyle}"
                                   Text="Format" />
                        <TextBlock x:Name="FormatTextBlock" />
                    </StackPanel>
                </Grid>
                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                    <TextBlock Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource FileFactLabelStyle}"
                               Text="Assigned hotkey" />
                    <Border HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Style="{StaticResource KeyCapChipStyle}">
                        <TextBlock x:Name="HotkeyTextBlock"
                                   Style="{StaticResource KeyCapTextStyle}" />
                    </Border>
                    <TextBlock Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource MutedTextStyle}"
                               Text="Change it from the tile menu" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!--
            Affirmative button first, matching the Windows desktop dialog
            convention, with Cancel to its right.
        -->
        <StackPanel Grid.Row="4"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button x:Name="SaveButton"
                    MinWidth="92"
                    Content="Save"
                    IsDefault="True"
                    IsEnabled="False"
                    Click="SaveButton_Click"
                    Style="{StaticResource PrimaryButtonStyle}"
                    ToolTip="Save the changed properties"
                    AutomationProperties.Name="Save sound properties" />
            <Button Margin="10,0,0,0"
                    MinWidth="92"
                    Content="Cancel"
                    Click="CancelButton_Click"
                    AutomationProperties.Name="Cancel without saving" />
        </StackPanel>
    </Grid>
</Window>
