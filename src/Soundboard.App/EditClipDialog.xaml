<Window x:Class="Soundboard.App.EditClipDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Soundboard.App"
        Title="Edit clip"
        Icon="Assets/Soundboard.ico"
        Width="900"
        Height="880"
        MinWidth="760"
        MinHeight="660"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="{StaticResource UiFontFamily}"
        FontSize="{StaticResource FontSizeBody}"
        Foreground="{StaticResource TextPrimaryBrush}"
        ShowInTaskbar="False"
        TextOptions.TextFormattingMode="Ideal"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style x:Key="ClipGroupStyle"
               TargetType="Border"
               BasedOn="{StaticResource SurfacePanelStyle}">
            <Setter Property="Margin" Value="0,14,0,0" />
        </Style>
        <Style x:Key="ReadoutValueStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="22,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource TitleTextStyle}"
                           Text="Edit clip" />
                <TextBlock x:Name="SoundNameTextBlock"
                           Margin="0,4,0,0"
                           Style="{StaticResource SecondaryTextStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <StackPanel Margin="0,0,22,0">
                    <TextBlock Style="{StaticResource MutedTextStyle}"
                               Text="Original duration" />
                    <TextBlock x:Name="OriginalDurationTextBlock"
                               Style="{StaticResource SecondaryTextStyle}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Style="{StaticResource MutedTextStyle}"
                               Text="Effective duration" />
                    <TextBlock x:Name="EffectiveDurationTextBlock"
                               Style="{StaticResource SubtitleTextStyle}" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Margin="0,0,8,0"
                       Style="{StaticResource MutedTextStyle}"
                       Text="Source file" />
            <TextBlock x:Name="OriginalFileNameTextBlock"
                       Grid.Column="1"
                       Style="{StaticResource MutedTextStyle}"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap" />
            <TextBlock Grid.Column="2"
                       Margin="16,0,8,0"
                       Style="{StaticResource MutedTextStyle}"
                       Text="Format" />
            <TextBlock x:Name="FormatTextBlock"
                       Grid.Column="3"
                       Style="{StaticResource MutedTextStyle}" />
        </Grid>

        <ScrollViewer Grid.Row="2"
                      Margin="0,4,0,0"
                      Padding="0,0,6,0"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Waveform: the centre of this dialog -->
                <Border Style="{StaticResource ClipGroupStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeadingTextStyle}"
                                   Text="ENTIRE ORIGINAL WAVEFORM" />
                        <local:WaveformEditorControl x:Name="WaveformEditor"
                                                     Height="230"
                                                     AutomationProperties.HelpText="S selects the start handle, E selects the end handle. Left and Right move the selected handle by 100 milliseconds; Shift uses 10 milliseconds and Control uses one second."
                                                     AutomationProperties.Name="Waveform trim editor" />
                        <TextBlock x:Name="WaveformStatusTextBlock"
                                   Margin="0,10,0,0"
                                   Style="{StaticResource MutedTextStyle}"
                                   Text="Loading decoded waveform…" />
                    </StackPanel>
                </Border>

                <!-- Trim and fades -->
                <Border Style="{StaticResource ClipGroupStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeadingTextStyle}"
                                   Text="TRIM AND FADES" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock Style="{StaticResource MutedTextStyle}"
                                           Text="Trim start" />
                                <TextBlock x:Name="TrimStartTextBlock"
                                           Style="{StaticResource ReadoutValueStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource MutedTextStyle}"
                                           Text="Trim end" />
                                <TextBlock x:Name="TrimEndTextBlock"
                                           Style="{StaticResource ReadoutValueStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource MutedTextStyle}"
                                           Text="Fade in" />
                                <TextBlock x:Name="FadeInTextBlock"
                                           Style="{StaticResource ReadoutValueStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Style="{StaticResource MutedTextStyle}"
                                           Text="Fade out" />
                                <TextBlock x:Name="FadeOutTextBlock"
                                           Style="{StaticResource ReadoutValueStyle}" />
                            </StackPanel>

                            <UniformGrid Grid.Row="1"
                                         Grid.ColumnSpan="4"
                                         Margin="0,14,0,0"
                                         Columns="4"
                                         Rows="2">
                                <Button Margin="0,0,8,8"
                                        Click="TrimStartEarlierButton_Click"
                                        Content="Start −"
                                        AutomationProperties.Name="Move trim start earlier" />
                                <Button Margin="0,0,8,8"
                                        Click="TrimStartLaterButton_Click"
                                        Content="Start +"
                                        AutomationProperties.Name="Move trim start later" />
                                <Button Margin="0,0,8,8"
                                        Click="TrimEndEarlierButton_Click"
                                        Content="End −"
                                        AutomationProperties.Name="Move trim end earlier" />
                                <Button Margin="0,0,0,8"
                                        Click="TrimEndLaterButton_Click"
                                        Content="End +"
                                        AutomationProperties.Name="Move trim end later" />
                                <Button Margin="0,0,8,0"
                                        Click="FadeInDecreaseButton_Click"
                                        Content="Fade in −"
                                        AutomationProperties.Name="Decrease fade in" />
                                <Button Margin="0,0,8,0"
                                        Click="FadeInIncreaseButton_Click"
                                        Content="Fade in +"
                                        AutomationProperties.Name="Increase fade in" />
                                <Button Margin="0,0,8,0"
                                        Click="FadeOutDecreaseButton_Click"
                                        Content="Fade out −"
                                        AutomationProperties.Name="Decrease fade out" />
                                <Button Click="FadeOutIncreaseButton_Click"
                                        Content="Fade out +"
                                        AutomationProperties.Name="Increase fade out" />
                            </UniformGrid>

                            <TextBlock Grid.Row="2"
                                       Grid.ColumnSpan="4"
                                       Margin="0,12,0,0"
                                       Style="{StaticResource MutedTextStyle}"
                                       Text="Buttons adjust by 100 ms. Hold Shift for 10 ms or Ctrl for 1 second. In the waveform, press S or E to select a handle, then use Left or Right with the same modifiers." />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Preview -->
                <Border Style="{StaticResource ClipGroupStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeadingTextStyle}"
                                   Text="PREVIEW" />
                        <StackPanel Orientation="Horizontal">
                            <Button MinWidth="120"
                                    Click="PlayPreviewButton_Click"
                                    Content="Play preview"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                            <Button Margin="10,0,0,0"
                                    MinWidth="120"
                                    Click="StopPreviewButton_Click"
                                    Content="Stop preview" />
                            <Button Margin="10,0,0,0"
                                    MinWidth="100"
                                    Click="ResetButton_Click"
                                    Content="Reset"
                                    Style="{StaticResource DangerButtonStyle}"
                                    AutomationProperties.Name="Reset clip edits" />
                        </StackPanel>
                        <TextBlock x:Name="PreviewStatusTextBlock"
                                   Margin="0,10,0,0"
                                   Style="{StaticResource MutedTextStyle}" />
                    </StackPanel>
                </Border>

                <TextBlock Margin="0,14,0,0"
                           Style="{StaticResource MutedTextStyle}"
                           Text="Edits affect playback only. The source and managed audio stay byte-for-byte unchanged, and preview is routed only to the selected physical monitor endpoint — never to Discord." />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="3"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button MinWidth="92"
                    Content="Cancel"
                    IsCancel="True"
                    Click="CancelButton_Click" />
            <Button Margin="10,0,0,0"
                    MinWidth="92"
                    Content="Save"
                    IsDefault="True"
                    Click="SaveButton_Click"
                    Style="{StaticResource PrimaryButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
