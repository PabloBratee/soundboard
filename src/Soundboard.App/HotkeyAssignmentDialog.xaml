<Window x:Class="Soundboard.App.HotkeyAssignmentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Assign hotkey"
        Width="520"
        Height="392"
        MinWidth="440"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="{StaticResource UiFontFamily}"
        FontSize="{StaticResource FontSizeBody}"
        Foreground="{StaticResource TextPrimaryBrush}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        TextOptions.TextFormattingMode="Ideal"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="22,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Style="{StaticResource TitleTextStyle}"
                       Text="Assign hotkey" />
            <TextBlock Margin="0,4,0,0"
                       Style="{StaticResource SecondaryTextStyle}"
                       Text="{Binding TargetName, RelativeSource={RelativeSource AncestorType=Window}}" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center"
                       Style="{StaticResource SecondaryTextStyle}"
                       Text="Current hotkey" />
            <Border Grid.Column="1"
                    HorizontalAlignment="Left"
                    Style="{StaticResource KeyCapChipStyle}">
                <TextBlock x:Name="CurrentHotkeyTextBlock"
                           Style="{StaticResource KeyCapTextStyle}"
                           Text="No hotkey" />
            </Border>
        </Grid>

        <Border x:Name="CaptureArea"
                Grid.Row="2"
                Margin="0,16,0,0"
                Padding="16"
                Background="{StaticResource SurfaceBackgroundBrush}"
                BorderBrush="{StaticResource AccentBrush}"
                BorderThickness="2"
                CornerRadius="{StaticResource SurfaceCornerRadius}"
                Focusable="True"
                SnapsToDevicePixels="True"
                PreviewKeyDown="CaptureArea_PreviewKeyDown"
                AutomationProperties.Name="Hotkey capture area"
                AutomationProperties.HelpText="Press one supported key combination. Escape cancels the dialog.">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionHeadingTextStyle}"
                           Margin="0,0,0,6"
                           Text="PROPOSED HOTKEY" />
                <TextBlock x:Name="ProposedHotkeyTextBlock"
                           FontFamily="{StaticResource DisplayFontFamily}"
                           FontSize="{StaticResource FontSizeDisplay}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Text="Press a combination…"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,8,0,0"
                           Style="{StaticResource MutedTextStyle}"
                           Text="Hold any modifiers, then press a non-modifier key." />
            </StackPanel>
        </Border>

        <TextBlock x:Name="ValidationTextBlock"
                   Grid.Row="3"
                   Margin="0,14,0,0"
                   Style="{StaticResource CaptionTextStyle}"
                   TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite" />

        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button MinWidth="110"
                    Content="Clear hotkey"
                    Click="ClearButton_Click"
                    Style="{StaticResource DangerButtonStyle}"
                    AutomationProperties.Name="Clear the assigned hotkey" />
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button MinWidth="92"
                        Content="Cancel"
                        IsCancel="True"
                        Click="CancelButton_Click" />
                <Button x:Name="SaveButton"
                        Margin="10,0,0,0"
                        MinWidth="92"
                        Content="Save"
                        IsDefault="True"
                        Click="SaveButton_Click"
                        Style="{StaticResource PrimaryButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
