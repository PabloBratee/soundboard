<Window x:Class="Soundboard.App.HotkeyAssignmentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Assign hotkey"
        Width="480"
        Height="285"
        MinWidth="420"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontWeight="SemiBold"
                       Text="{Binding TargetName, RelativeSource={RelativeSource AncestorType=Window}}" />
            <TextBlock Margin="0,5,0,0"
                       Foreground="#4A5562"
                       Text="Press one supported key combination in the capture area."
                       TextWrapping="Wrap" />
        </StackPanel>

        <Border x:Name="CaptureArea"
                Grid.Row="1"
                Margin="0,14,0,0"
                Padding="14"
                Focusable="True"
                Background="#F4F7FA"
                BorderBrush="#557A9B"
                BorderThickness="2"
                CornerRadius="5"
                PreviewKeyDown="CaptureArea_PreviewKeyDown">
            <StackPanel>
                <TextBlock FontWeight="SemiBold"
                           Text="Hotkey capture" />
                <TextBlock x:Name="ProposedHotkeyTextBlock"
                           Margin="0,8,0,0"
                           FontSize="19"
                           FontWeight="SemiBold"
                           Text="Press a combination…" />
            </StackPanel>
        </Border>

        <TextBlock x:Name="ValidationTextBlock"
                   Grid.Row="2"
                   Margin="0,12,0,0"
                   Foreground="DarkRed"
                   TextWrapping="Wrap" />

        <Grid Grid.Row="3"
              Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button MinWidth="105"
                    Padding="10,6"
                    Click="ClearButton_Click"
                    Content="Clear hotkey" />
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal">
                <Button MinWidth="88"
                        Padding="10,6"
                        IsCancel="True"
                        Click="CancelButton_Click"
                        Content="Cancel" />
                <Button x:Name="SaveButton"
                        Margin="9,0,0,0"
                        MinWidth="88"
                        Padding="10,6"
                        IsDefault="True"
                        Click="SaveButton_Click"
                        Content="Save" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
