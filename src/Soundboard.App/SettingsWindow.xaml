<Window x:Class="Soundboard.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Soundboard settings"
        Icon="Assets/Soundboard.ico"
        Width="820"
        Height="720"
        MinWidth="640"
        MinHeight="520"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="{StaticResource UiFontFamily}"
        FontSize="{StaticResource FontSizeBody}"
        Foreground="{StaticResource TextPrimaryBrush}"
        ShowInTaskbar="False"
        TextOptions.TextFormattingMode="Ideal"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style x:Key="SettingsGroupStyle"
               TargetType="Border"
               BasedOn="{StaticResource SurfacePanelStyle}">
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="FieldLabelStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource SubtitleTextStyle}">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="ValueTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource SecondaryTextStyle}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

        <!--
            An explicit ItemTemplate rather than DisplayMemberPath: the
            themed ComboBox draws its selected value through
            SelectionBoxItemTemplate, which is only populated from
            ItemTemplate. DisplayMemberPath would leave the collapsed
            ComboBox showing the endpoint's raw ToString().
        -->
        <DataTemplate x:Key="AudioEndpointTemplate">
            <TextBlock Text="{Binding FriendlyName}"
                       TextTrimming="CharacterEllipsis" />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="20,16,20,0"
                Background="{StaticResource SidebarBackgroundBrush}">
            <StackPanel>
                <TextBlock Style="{StaticResource DisplayTextStyle}"
                           Text="Settings" />
                <TextBlock Margin="0,4,0,12"
                           Style="{StaticResource SecondaryTextStyle}"
                           Text="Choose your microphone once. Soundboard starts audio automatically and keeps it available while the app is open." />
            </StackPanel>
        </Border>

        <TabControl x:Name="SettingsTabControl"
                    Grid.Row="1"
                    Background="{StaticResource AppBackgroundBrush}">

            <!-- ==================== Audio devices ==================== -->
            <TabItem Header="Audio devices">
                <ScrollViewer Padding="20,18"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border x:Name="SetupBanner"
                                Style="{StaticResource SettingsGroupStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SubtitleTextStyle}"
                                           Text="Finish first-time audio setup" />
                                <TextBlock Margin="0,6,0,0"
                                           Style="{StaticResource SecondaryTextStyle}"
                                           Text="Use the recommended Windows default microphone or pin one device. Then select CABLE Input below and choose CABLE Output once in Discord or your game." />
                                <Button x:Name="CompleteSetupButton"
                                        Margin="0,14,0,0"
                                        HorizontalAlignment="Left"
                                        Content="Complete setup"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeadingTextStyle}"
                                           Text="YOUR MICROPHONE" />
                                <CheckBox x:Name="UseDefaultMicrophoneCheckBox"
                                          Margin="0,0,0,14"
                                          Content="Use Windows default communications microphone (recommended)" />
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           Text="Input device" />
                                <ComboBox x:Name="MicrophoneComboBox"
                                          ItemTemplate="{StaticResource AudioEndpointTemplate}"
                                          IsTextSearchEnabled="True"
                                          TextSearch.TextPath="FriendlyName"
                                          AutomationProperties.Name="Microphone input device" />
                                <TextBlock x:Name="MicrophoneSelectionStatusTextBlock"
                                           Margin="0,7,0,0"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Text="Checking microphone selection…" />

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="52" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="TestMicrophoneButton"
                                            Margin="0,0,16,0"
                                            Content="Test microphone" />
                                    <ProgressBar x:Name="MicrophonePeakProgressBar"
                                                 Grid.Column="1"
                                                 Maximum="1"
                                                 AutomationProperties.Name="Microphone peak level" />
                                    <TextBlock x:Name="MicrophonePeakTextBlock"
                                               Grid.Column="2"
                                               Style="{StaticResource ValueTextStyle}"
                                               Text="0%" />
                                </Grid>
                                <TextBlock x:Name="MicrophoneTestStatusTextBlock"
                                           Margin="0,8,0,0"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Text="Speak to see the live input level." />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeadingTextStyle}"
                                           Text="VOICE PRIORITY" />
                                <TextBlock Style="{StaticResource SecondaryTextStyle}"
                                           Text="Automatically lowers sounds while you speak. Turn Voice Priority on or off from the main window; your microphone is never lowered." />
                                <TextBlock x:Name="VoicePriorityStateTextBlock"
                                           Margin="0,6,0,0"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Text="Voice Priority is off." />

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center"
                                               Style="{StaticResource SecondaryTextStyle}"
                                               Text="Voice sensitivity" />
                                    <ComboBox x:Name="VoiceSensitivityComboBox"
                                              Grid.Column="1"
                                              SelectedIndex="1"
                                              AutomationProperties.Name="Voice sensitivity">
                                        <ComboBoxItem Content="Low — engages around -30 dBFS" />
                                        <ComboBoxItem Content="Normal — engages around -36 dBFS" />
                                        <ComboBoxItem Content="High — engages around -42 dBFS" />
                                    </ComboBox>
                                </Grid>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center"
                                               Style="{StaticResource SecondaryTextStyle}"
                                               Text="Ducking strength" />
                                    <ComboBox x:Name="VoiceDuckingStrengthComboBox"
                                              Grid.Column="1"
                                              SelectedIndex="1"
                                              AutomationProperties.Name="Ducking strength">
                                        <ComboBoxItem Content="Light — sounds drop by 6 dB" />
                                        <ComboBoxItem Content="Balanced — sounds drop by 12 dB" />
                                        <ComboBoxItem Content="Strong — sounds drop by 18 dB" />
                                    </ComboBox>
                                </Grid>

                                <TextBlock Margin="0,12,0,0"
                                           Style="{StaticResource MutedTextStyle}"
                                           Text="Sounds fade down over 50 ms, stay lowered for at least 200 ms, and return over 500 ms. Playback is never paused, restarted, normalized, or compressed." />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeadingTextStyle}"
                                           Text="SOUNDBOARD MICROPHONE" />
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           Text="VB-CABLE connection" />
                                <ComboBox x:Name="VirtualOutputComboBox"
                                          ItemTemplate="{StaticResource AudioEndpointTemplate}"
                                          IsTextSearchEnabled="True"
                                          TextSearch.TextPath="FriendlyName"
                                          AutomationProperties.Name="Virtual output device" />

                                <TextBlock x:Name="VirtualRoutingTextBlock"
                                           Margin="0,12,0,0"
                                           Style="{StaticResource SecondaryTextStyle}"
                                           Text="Microphone + Soundboard → CABLE Input" />
                                <TextBlock Margin="0,6,0,0"
                                           Style="{StaticResource SecondaryTextStyle}"
                                           Text="Select the matching CABLE Output once as the microphone in Discord or your game." />
                                <TextBlock x:Name="VirtualCableStatusTextBlock"
                                           Margin="0,6,0,0"
                                           Foreground="{StaticResource WarningBrush}"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Text="Checking for VB-CABLE endpoints…" />

                                <TextBlock Margin="0,14,0,0"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Text="Output format" />
                                <TextBlock x:Name="TargetFormatTextBlock"
                                           Style="{StaticResource SecondaryTextStyle}"
                                           Text="Select a render endpoint." />

                                <StackPanel Margin="0,16,0,0"
                                            Orientation="Horizontal">
                                    <Button x:Name="RefreshDevicesButton"
                                            Content="Restart audio service"
                                            AutomationProperties.Name="Restart audio service and refresh devices" />
                                    <TextBlock x:Name="DeviceCountsTextBlock"
                                               Margin="14,0,0,0"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource MutedTextStyle}"
                                               Text="Waiting for discovery…" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource MutedTextStyle}"
                                   Text="Device changes restart only Soundboard's local audio service. Windows defaults and per-application settings are never changed." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== Monitoring ==================== -->
            <TabItem Header="Monitoring">
                <ScrollViewer Padding="20,18"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeadingTextStyle}"
                                           Text="HEADPHONE MONITORING" />
                                <CheckBox x:Name="MonitorSoundsCheckBox"
                                          Content="Monitor sounds through headphones" />

                                <TextBlock Margin="0,16,0,0"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Text="Physical monitor output" />
                                <ComboBox x:Name="MonitorOutputComboBox"
                                          ItemTemplate="{StaticResource AudioEndpointTemplate}"
                                          IsTextSearchEnabled="True"
                                          TextSearch.TextPath="FriendlyName"
                                          AutomationProperties.Name="Physical monitor output device" />

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="52" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center"
                                               Style="{StaticResource SecondaryTextStyle}"
                                               Text="Monitor volume" />
                                    <Slider x:Name="MonitorVolumeSlider"
                                            Grid.Column="1"
                                            Minimum="0"
                                            Maximum="100"
                                            Value="100"
                                            TickFrequency="10"
                                            AutomationProperties.Name="Monitor volume percent" />
                                    <TextBlock x:Name="MonitorVolumeTextBlock"
                                               Grid.Column="2"
                                               Style="{StaticResource ValueTextStyle}"
                                               Text="100%" />
                                </Grid>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="52" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center"
                                               Style="{StaticResource SecondaryTextStyle}"
                                               Text="Monitor peak" />
                                    <ProgressBar x:Name="MonitorPeakProgressBar"
                                                 Grid.Column="1"
                                                 Maximum="1"
                                                 AutomationProperties.Name="Monitor peak level" />
                                    <TextBlock x:Name="MonitorPeakTextBlock"
                                               Grid.Column="2"
                                               Style="{StaticResource ValueTextStyle}"
                                               Text="0%" />
                                </Grid>

                                <TextBlock x:Name="MonitorRoutingTextBlock"
                                           Margin="0,14,0,0"
                                           Style="{StaticResource SecondaryTextStyle}"
                                           Text="Soundboard only → select a physical output" />
                                <TextBlock x:Name="MonitorStatusTextBlock"
                                           Margin="0,6,0,0"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Text="Monitoring is disabled." />
                            </StackPanel>
                        </Border>

                        <Border Padding="14"
                                Background="{StaticResource AccentSubtleBrush}"
                                BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource SurfaceCornerRadius}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,12,0"
                                           VerticalAlignment="Top"
                                           FontFamily="{StaticResource IconFontFamily}"
                                           FontSize="16"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Text="&#xE946;" />
                                <TextBlock MaxWidth="600"
                                           Style="{StaticResource BodyTextStyle}"
                                           Text="Your microphone is never monitored through this app. Only soundboard audio is sent to the headphone output, so you will never hear yourself and cannot create a feedback loop." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== Hotkeys ==================== -->
            <TabItem Header="Hotkeys">
                <ScrollViewer Padding="20,18"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="GlobalHotkeysCheckBox"
                                              VerticalAlignment="Center"
                                              Content="Enable global hotkeys" />
                                    <TextBlock x:Name="RegisteredHotkeyCountTextBlock"
                                               Grid.Column="1"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource SubtitleTextStyle}"
                                               Text="0 registered" />
                                </Grid>
                                <TextBlock x:Name="HotkeyStatusTextBlock"
                                           Margin="0,12,0,0"
                                           Style="{StaticResource SecondaryTextStyle}"
                                           Text="Hotkeys are initializing." />
                                <Button x:Name="RetryHotkeysButton"
                                        Margin="0,14,0,0"
                                        HorizontalAlignment="Left"
                                        Content="Retry unavailable hotkeys" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeadingTextStyle}"
                                           Text="STOP SOUND HOTKEY" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <Border HorizontalAlignment="Left"
                                                Style="{StaticResource KeyCapChipStyle}">
                                            <TextBlock x:Name="StopHotkeyDisplayTextBlock"
                                                       Style="{StaticResource KeyCapTextStyle}"
                                                       Text="No hotkey" />
                                        </Border>
                                        <TextBlock x:Name="StopHotkeyStateTextBlock"
                                                   Margin="0,6,0,0"
                                                   Style="{StaticResource MutedTextStyle}"
                                                   Text="Not assigned" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal">
                                        <Button x:Name="AssignStopHotkeyButton"
                                                Content="Assign hotkey"
                                                AutomationProperties.Name="Assign Stop Sound hotkey" />
                                        <Button x:Name="ClearStopHotkeyButton"
                                                Margin="8,0,0,0"
                                                Content="Clear"
                                                Style="{StaticResource DangerButtonStyle}"
                                                AutomationProperties.Name="Clear Stop Sound hotkey" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeadingTextStyle}"
                                           Text="PAUSE/RESUME PLAYBACK HOTKEY" />
                                <TextBlock Margin="0,0,0,10"
                                           Style="{StaticResource SecondaryTextStyle}"
                                           Text="Optional and unassigned by default. Pausing holds every playing sound at its exact position; your microphone keeps running." />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <Border HorizontalAlignment="Left"
                                                Style="{StaticResource KeyCapChipStyle}">
                                            <TextBlock x:Name="PauseHotkeyDisplayTextBlock"
                                                       Style="{StaticResource KeyCapTextStyle}"
                                                       Text="No hotkey" />
                                        </Border>
                                        <TextBlock x:Name="PauseHotkeyStateTextBlock"
                                                   Margin="0,6,0,0"
                                                   Style="{StaticResource MutedTextStyle}"
                                                   Text="Not assigned" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal">
                                        <Button x:Name="AssignPauseHotkeyButton"
                                                Content="Assign hotkey"
                                                AutomationProperties.Name="Assign Pause/Resume playback hotkey" />
                                        <Button x:Name="ClearPauseHotkeyButton"
                                                Margin="8,0,0,0"
                                                Content="Clear"
                                                Style="{StaticResource DangerButtonStyle}"
                                                AutomationProperties.Name="Clear Pause/Resume playback hotkey" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Padding="14"
                                Background="{StaticResource SurfaceBackgroundBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource SurfaceCornerRadius}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SubtitleTextStyle}"
                                           Text="Privacy" />
                                <TextBlock Margin="0,6,0,0"
                                           Style="{StaticResource SecondaryTextStyle}"
                                           Text="Only explicitly registered combinations are received. Soundboard does not monitor or record other keyboard input. Per-sound hotkeys are assigned from each tile's action menu on the soundboard." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== Diagnostics ==================== -->
            <TabItem Header="Diagnostics">
                <Grid Margin="20,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="125" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="52" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   Text="Final output peak" />
                        <ProgressBar x:Name="OutputPeakProgressBar"
                                     Grid.Column="1"
                                     Maximum="1"
                                     AutomationProperties.Name="Final output peak level" />
                        <TextBlock x:Name="OutputPeakTextBlock"
                                   Grid.Column="2"
                                   Style="{StaticResource ValueTextStyle}"
                                   Text="0%" />
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,14,0,10">
                        <TextBlock Style="{StaticResource SectionHeadingTextStyle}"
                                   Text="STORAGE LOCATIONS" />
                        <TextBox x:Name="StoragePathsTextBox"
                                 Padding="10,8"
                                 Style="{StaticResource DiagnosticTextBoxStyle}"
                                 Text="Loading…"
                                 TextWrapping="NoWrap"
                                 HorizontalScrollBarVisibility="Auto"
                                 AutomationProperties.Name="Storage locations" />
                    </StackPanel>

                    <TextBox x:Name="DiagnosticStatusTextBox"
                             Grid.Row="2"
                             Padding="10,8"
                             Style="{StaticResource DiagnosticTextBoxStyle}"
                             Text="Diagnostics are loading."
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Auto"
                             AutomationProperties.Name="Engine diagnostics" />
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2"
                Padding="20,12"
                Background="{StaticResource SidebarBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           Style="{StaticResource MutedTextStyle}"
                           Text="Settings are saved automatically." />
                <Button x:Name="CloseSettingsButton"
                        Grid.Column="1"
                        MinWidth="96"
                        Content="Close"
                        IsDefault="True"
                        Click="CloseSettingsButton_Click"
                        Style="{StaticResource PrimaryButtonStyle}" />
            </Grid>
        </Border>
    </Grid>
</Window>
