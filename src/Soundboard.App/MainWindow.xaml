<Window x:Class="Soundboard.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Soundboard"
        Width="1020"
        Height="920"
        MinWidth="760"
        MinHeight="680"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#F4F6F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="22,16"
                Background="#202936">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="27"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Text="Soundboard" />
                    <TextBlock Margin="0,4,0,0"
                               Foreground="#C8D2DF"
                               Text="One-shot sounds to Discord, with optional sound-only headphone monitoring" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center"
                               Foreground="#C8D2DF"
                               Text="Engine: " />
                    <TextBlock x:Name="EngineStateTextBlock"
                               VerticalAlignment="Center"
                               FontWeight="Bold"
                               Foreground="White"
                               Text="Stopped" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">
                <Expander Margin="0,0,0,14"
                          IsExpanded="True"
                          Header="Audio routing and controls">
                    <Border Margin="0,8,0,0"
                            Padding="14"
                            Background="White"
                            BorderBrush="#D6DBE1"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock FontWeight="SemiBold"
                                           Text="Microphone" />
                                <ComboBox x:Name="MicrophoneComboBox"
                                          Margin="0,6,0,0"
                                          MinHeight="32"
                                          DisplayMemberPath="FriendlyName"
                                          IsTextSearchEnabled="True" />

                                <Grid Margin="0,13,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="55" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center"
                                               Text="Volume" />
                                    <Slider x:Name="MicrophoneVolumeSlider"
                                            Grid.Column="1"
                                            Minimum="0"
                                            Maximum="200"
                                            Value="100"
                                            TickFrequency="10" />
                                    <TextBlock x:Name="MicrophoneVolumeTextBlock"
                                               Grid.Column="2"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               Text="100%" />
                                </Grid>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="135" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="55" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="MuteMicrophoneCheckBox"
                                              VerticalAlignment="Center"
                                              Content="Mute microphone" />
                                    <ProgressBar x:Name="MicrophonePeakProgressBar"
                                                 Grid.Column="1"
                                                 Height="15"
                                                 Maximum="1" />
                                    <TextBlock x:Name="MicrophonePeakTextBlock"
                                               Grid.Column="2"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               Text="0%" />
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock FontWeight="SemiBold"
                                           Text="Virtual output" />
                                <ComboBox x:Name="VirtualOutputComboBox"
                                          Margin="0,6,0,0"
                                          MinHeight="32"
                                          DisplayMemberPath="FriendlyName"
                                          IsTextSearchEnabled="True" />

                                <StackPanel Margin="0,13,0,0"
                                            Orientation="Horizontal">
                                    <Button x:Name="RefreshDevicesButton"
                                            Padding="11,6"
                                            Click="RefreshDevicesButton_Click"
                                            Content="Refresh devices" />
                                    <TextBlock x:Name="DeviceCountsTextBlock"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="#4A5562"
                                               Text="Waiting for discovery…" />
                                </StackPanel>

                                <StackPanel Margin="0,12,0,0"
                                            Orientation="Horizontal">
                                    <Button x:Name="StartEngineButton"
                                            MinWidth="140"
                                            Padding="11,7"
                                            Click="StartEngineButton_Click"
                                            Content="Start audio engine" />
                                    <Button x:Name="StopEngineButton"
                                            Margin="10,0,0,0"
                                            MinWidth="140"
                                            Padding="11,7"
                                            Click="StopEngineButton_Click"
                                            Content="Stop audio engine" />
                                </StackPanel>

                                <TextBlock x:Name="VirtualCableStatusTextBlock"
                                           Margin="0,11,0,0"
                                           Foreground="#8A5A00"
                                           Text="Checking for VB-CABLE endpoints…"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Expander>

                <Border Margin="0,0,0,14"
                        Padding="14"
                        Background="White"
                        BorderBrush="#D6DBE1"
                        BorderThickness="1"
                        CornerRadius="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock FontSize="16"
                                       FontWeight="SemiBold"
                                       Text="Local sound monitoring" />
                            <CheckBox x:Name="MonitorSoundsCheckBox"
                                      Margin="0,10,0,0"
                                      Content="Monitor sounds through headphones" />
                            <TextBlock Margin="0,12,0,0"
                                       FontWeight="SemiBold"
                                       Text="Physical monitor output" />
                            <ComboBox x:Name="MonitorOutputComboBox"
                                      Margin="0,6,0,0"
                                      MinHeight="32"
                                      DisplayMemberPath="FriendlyName"
                                      IsTextSearchEnabled="True" />

                            <Grid Margin="0,13,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="105" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="55" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center"
                                           Text="Monitor volume" />
                                <Slider x:Name="MonitorVolumeSlider"
                                        Grid.Column="1"
                                        Minimum="0"
                                        Maximum="200"
                                        Value="100"
                                        TickFrequency="10" />
                                <TextBlock x:Name="MonitorVolumeTextBlock"
                                           Grid.Column="2"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="100%" />
                            </Grid>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="105" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="55" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center"
                                           Text="Monitor peak" />
                                <ProgressBar x:Name="MonitorPeakProgressBar"
                                             Grid.Column="1"
                                             Height="15"
                                             Maximum="1" />
                                <TextBlock x:Name="MonitorPeakTextBlock"
                                           Grid.Column="2"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="0%" />
                            </Grid>

                            <TextBlock x:Name="MonitorStatusTextBlock"
                                       Margin="0,11,0,0"
                                       Foreground="#4A5562"
                                       Text="Monitoring is disabled."
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock FontSize="16"
                                       FontWeight="SemiBold"
                                       Text="Routing" />
                            <TextBlock Margin="0,10,0,0"
                                       FontWeight="SemiBold"
                                       Text="To Discord:" />
                            <TextBlock x:Name="VirtualRoutingTextBlock"
                                       Margin="0,3,0,0"
                                       Text="Microphone + Soundboard → CABLE Input"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,14,0,0"
                                       FontWeight="SemiBold"
                                       Text="To your headphones:" />
                            <TextBlock x:Name="MonitorRoutingTextBlock"
                                       Margin="0,3,0,0"
                                       Text="Soundboard only → select a physical output"
                                       TextWrapping="Wrap" />

                            <Border Margin="0,18,0,0"
                                    Padding="10"
                                    Background="#EAF4FC"
                                    BorderBrush="#8CB9D9"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                <TextBlock FontWeight="SemiBold"
                                           Foreground="#174D70"
                                           Text="Your microphone is never monitored through this app."
                                           TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Margin="0,0,0,14"
                        Padding="14"
                        Background="White"
                        BorderBrush="#D6DBE1"
                        BorderThickness="1"
                        CornerRadius="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ImportSoundsButton"
                                    Padding="13,7"
                                    Click="ImportSoundsButton_Click"
                                    Content="Import sounds" />
                            <Button x:Name="StopSoundButton"
                                    Margin="10,0,0,0"
                                    Padding="13,7"
                                    Click="StopSoundButton_Click"
                                    Content="Stop sound" />
                            <TextBlock x:Name="SoundCountTextBlock"
                                       Margin="14,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="#4A5562"
                                       Text="0 sounds" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal">
                            <TextBlock Margin="0,0,8,0"
                                       VerticalAlignment="Center"
                                       Text="Search" />
                            <TextBox x:Name="SearchTextBox"
                                     Width="220"
                                     MinHeight="30"
                                     Padding="7,4"
                                     VerticalContentAlignment="Center"
                                     TextChanged="SearchTextBox_TextChanged" />
                        </StackPanel>

                        <Grid Grid.Row="1"
                              Grid.ColumnSpan="2"
                              Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="95" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="55" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       Text="Sound volume" />
                            <Slider x:Name="SoundVolumeSlider"
                                    Grid.Column="1"
                                    Minimum="0"
                                    Maximum="200"
                                    Value="100"
                                    TickFrequency="10" />
                            <TextBlock x:Name="SoundVolumeTextBlock"
                                       Grid.Column="2"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="100%" />
                        </Grid>

                        <TextBlock x:Name="CurrentSoundTextBlock"
                                   Grid.Row="2"
                                   Grid.ColumnSpan="2"
                                   Margin="0,10,0,0"
                                   Foreground="#4A5562"
                                   Text="Current sound: none" />
                    </Grid>
                </Border>

                <Border x:Name="SoundboardDropArea"
                        MinHeight="245"
                        Padding="10"
                        AllowDrop="True"
                        Background="#F9FAFB"
                        BorderBrush="#BFC7D1"
                        BorderThickness="1"
                        CornerRadius="6"
                        Drop="SoundboardDropArea_Drop"
                        PreviewDragOver="SoundboardDropArea_PreviewDragOver">
                    <Grid>
                        <TextBlock x:Name="EmptyLibraryTextBlock"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="16"
                                   Foreground="#66717E"
                                   Text="No sounds yet. Import WAV or MP3 files, or drop them here."
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />

                        <ItemsControl x:Name="SoundTilesItemsControl">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="TileBorder"
                                            Width="205"
                                            MinHeight="142"
                                            Margin="7"
                                            Padding="10"
                                            Background="White"
                                            BorderBrush="#CBD2DA"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Button Padding="8"
                                                    HorizontalContentAlignment="Stretch"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Click="PlayTileButton_Click"
                                                    Tag="{Binding}">
                                                <StackPanel>
                                                    <TextBlock FontSize="16"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding DisplayName}"
                                                               TextAlignment="Left"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding DisplayName}" />
                                                    <TextBlock Margin="0,6,0,0"
                                                               Foreground="#596574"
                                                               Text="{Binding DurationText}"
                                                               TextAlignment="Left" />
                                                    <TextBlock Margin="0,8,0,0"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding PlayingLabel}"
                                                               TextAlignment="Left" />
                                                </StackPanel>
                                            </Button>
                                            <Separator Grid.Row="1"
                                                       Margin="0,6" />
                                            <StackPanel Grid.Row="2"
                                                        HorizontalAlignment="Right"
                                                        Orientation="Horizontal">
                                                <Button Padding="8,4"
                                                        Click="RenameTileButton_Click"
                                                        Content="Rename"
                                                        Tag="{Binding}" />
                                                <Button Margin="7,0,0,0"
                                                        Padding="8,4"
                                                        Click="RemoveTileButton_Click"
                                                        Content="Remove"
                                                        Tag="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsPlaying}"
                                                     Value="True">
                                            <Setter TargetName="TileBorder"
                                                    Property="BorderBrush"
                                                    Value="#1967A3" />
                                            <Setter TargetName="TileBorder"
                                                    Property="BorderThickness"
                                                    Value="3" />
                                            <Setter TargetName="TileBorder"
                                                    Property="Background"
                                                    Value="#EAF4FC" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <Expander Margin="0,14,0,0"
                          Header="Diagnostics">
                    <Border Margin="0,8,0,0"
                            Padding="12"
                            Background="White"
                            BorderBrush="#D6DBE1"
                            BorderThickness="1"
                            CornerRadius="6">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="55" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Final output peak" />
                                <ProgressBar x:Name="OutputPeakProgressBar"
                                             Grid.Column="1"
                                             Height="15"
                                             Maximum="1" />
                                <TextBlock x:Name="OutputPeakTextBlock"
                                           Grid.Column="2"
                                           Margin="8,0,0,0"
                                           Text="0%" />
                            </Grid>
                            <TextBlock x:Name="TargetFormatTextBlock"
                                       Margin="0,10,0,0"
                                       Text="Select a render endpoint."
                                       TextWrapping="Wrap" />
                            <TextBox x:Name="DiagnosticStatusTextBox"
                                     Height="245"
                                     Margin="0,10,0,0"
                                     Padding="8"
                                     AcceptsReturn="True"
                                     Background="#FAFAFA"
                                     BorderThickness="0"
                                     FontFamily="Consolas"
                                     HorizontalScrollBarVisibility="Auto"
                                     IsReadOnly="True"
                                     Text="Diagnostics are loading."
                                     VerticalScrollBarVisibility="Auto" />
                        </StackPanel>
                    </Border>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Padding="20,10"
                Background="White"
                BorderBrush="#D6DBE1"
                BorderThickness="0,1,0,0">
            <StackPanel>
                <TextBlock x:Name="StatusTextBlock"
                           FontWeight="SemiBold"
                           Text="Ready."
                           TextWrapping="Wrap" />
                <TextBlock x:Name="ErrorTextBlock"
                           Margin="0,4,0,0"
                           Foreground="DarkRed"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
