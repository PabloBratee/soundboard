<Window x:Class="Soundboard.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Soundboard"
        Icon="Assets/Soundboard.ico"
        Width="1180"
        Height="820"
        MinWidth="880"
        MinHeight="620"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="{StaticResource UiFontFamily}"
        FontSize="{StaticResource FontSizeBody}"
        Foreground="{StaticResource TextPrimaryBrush}"
        PreviewKeyDown="MainWindow_PreviewKeyDown"
        TextOptions.TextFormattingMode="Ideal"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!-- Search field container; mirrors TextBox focus state. -->
        <Style x:Key="SearchContainerStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=SearchTextBox}"
                             Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource FocusBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Error line hides itself when the message is cleared. -->
        <Style x:Key="ErrorLineStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource CaptionTextStyle}">
            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Tile accent strip. The only place a preset colour is applied. -->
        <Style x:Key="TileAccentStripStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource TileAccentDefaultBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding TileAccent}" Value="Blue">
                    <Setter Property="Background" Value="{StaticResource TileAccentBlueBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding TileAccent}" Value="Purple">
                    <Setter Property="Background" Value="{StaticResource TileAccentPurpleBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding TileAccent}" Value="Green">
                    <Setter Property="Background" Value="{StaticResource TileAccentGreenBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding TileAccent}" Value="Orange">
                    <Setter Property="Background" Value="{StaticResource TileAccentOrangeBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding TileAccent}" Value="Red">
                    <Setter Property="Background" Value="{StaticResource TileAccentRedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding TileAccent}" Value="Pink">
                    <Setter Property="Background" Value="{StaticResource TileAccentPinkBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding TileAccent}" Value="Teal">
                    <Setter Property="Background" Value="{StaticResource TileAccentTealBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Whole-tile primary surface. Chrome-free; the tile Border draws it. -->
        <Style x:Key="TileSurfaceButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Compact secondary chip used for hotkey, category, and clip-edit
            state. One shared style keeps every badge on the same radius,
            padding, and border so the tile reads as a single system.
        -->
        <Style x:Key="TileChipStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="TileChipTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeMicro}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- Hover/focus-revealed tile action. -->
        <Style x:Key="TileActionButtonStyle"
               TargetType="ButtonBase"
               BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        </Style>

        <Style x:Key="StatusChipStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="Background" Value="{StaticResource SurfaceBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource PillCornerRadius}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== Top bar ==================== -->
        <Border Padding="18,10"
                Background="{StaticResource SidebarBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Border Width="30"
                            Height="30"
                            Background="{StaticResource AccentBrush}"
                            CornerRadius="8">
                        <TextBlock FontFamily="{StaticResource IconFontFamily}"
                                   FontSize="15"
                                   Foreground="{StaticResource TextOnAccentBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Text="&#xE767;" />
                    </Border>
                    <TextBlock Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource TitleTextStyle}"
                               Text="Soundboard" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Margin="22,0,0,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Border x:Name="EngineStatePill"
                            Padding="10,4"
                            Background="{StaticResource SurfaceBackgroundBrush}"
                            BorderBrush="{StaticResource BorderStrongBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource PillCornerRadius}"
                            SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="EngineStateGlyph"
                                       Margin="0,0,7,0"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource IconFontFamily}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Text="&#xE71A;" />
                            <TextBlock Margin="0,0,5,0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Text="Audio" />
                            <TextBlock x:Name="EngineStateTextBlock"
                                       VerticalAlignment="Center"
                                       FontSize="{StaticResource FontSizeCaption}"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="Connecting" />
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="MicrophoneStateTextBlock"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource MutedTextStyle}"
                               Text="Microphone idle" />
                </StackPanel>

                <StackPanel Grid.Column="3"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Button x:Name="StopSoundButton"
                            MinWidth="118"
                            Click="StopSoundButton_Click"
                            Style="{StaticResource PrimaryButtonStyle}"
                            ToolTip="Stop the sound that is currently playing. The microphone keeps running."
                            AutomationProperties.Name="Stop sound">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="0,0,7,0"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource IconFontFamily}"
                                       FontSize="12"
                                       Text="&#xE71A;" />
                            <TextBlock VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Text="Stop Sound" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="SettingsButton"
                            Margin="12,0,0,0"
                            Click="SettingsButton_Click"
                            Content="&#xE713;"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="Settings — devices, monitoring, hotkeys, diagnostics"
                            AutomationProperties.Name="Open settings" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== Body ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="216" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Library sidebar -->
            <Border Background="{StaticResource SidebarBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <DockPanel Margin="10,14,10,10">
                    <Grid DockPanel.Dock="Top" Margin="4,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   Style="{StaticResource SectionHeadingTextStyle}"
                                   Margin="0"
                                   Text="LIBRARY" />
                        <Button x:Name="CreateCategoryButton"
                                Grid.Column="1"
                                Width="28"
                                Height="28"
                                Click="CreateCategoryButton_Click"
                                Content="&#xE710;"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTip="New category — type a name and press Enter"
                                AutomationProperties.Name="New category" />
                        <Button x:Name="ManageCategoriesButton"
                                Grid.Column="2"
                                Width="28"
                                Height="28"
                                Click="ManageCategoriesButton_Click"
                                Content="&#xE712;"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTip="Manage the selected category"
                                AutomationProperties.Name="Manage selected category">
                            <Button.ContextMenu>
                                <ContextMenu x:Name="CategoryActionsMenu">
                                    <MenuItem x:Name="RenameCategoryMenuItem"
                                              Header="Rename category"
                                              Click="RenameCategoryButton_Click"
                                              AutomationProperties.Name="Rename selected category" />
                                    <MenuItem x:Name="MoveCategoryUpMenuItem"
                                              Header="Move category earlier"
                                              Click="MoveCategoryUpButton_Click"
                                              AutomationProperties.Name="Move selected category earlier" />
                                    <MenuItem x:Name="MoveCategoryDownMenuItem"
                                              Header="Move category later"
                                              Click="MoveCategoryDownButton_Click"
                                              AutomationProperties.Name="Move selected category later" />
                                    <Separator />
                                    <MenuItem x:Name="DeleteCategoryMenuItem"
                                              Header="Delete category…"
                                              Click="DeleteCategoryButton_Click"
                                              AutomationProperties.Name="Delete selected category" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </Grid>

                    <!--
                        Inline category editor. Creating and renaming a
                        category is a one-field operation, so it happens in
                        place instead of in a modal window.
                    -->
                    <Border x:Name="CategoryEditorPanel"
                            DockPanel.Dock="Top"
                            Margin="0,0,0,8"
                            Padding="8"
                            Background="{StaticResource SurfaceBackgroundBrush}"
                            BorderBrush="{StaticResource BorderStrongBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource ControlCornerRadius}"
                            SnapsToDevicePixels="True"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="CategoryEditorTitleTextBlock"
                                       Margin="0,0,0,6"
                                       Style="{StaticResource SectionHeadingTextStyle}"
                                       Text="NEW CATEGORY" />
                            <TextBox x:Name="CategoryEditorTextBox"
                                     MaxLength="60"
                                     KeyDown="CategoryEditorTextBox_KeyDown"
                                     TextChanged="CategoryEditorTextBox_TextChanged"
                                     ToolTip="Press Enter to confirm or Escape to cancel"
                                     AutomationProperties.Name="Category name" />
                            <TextBlock x:Name="CategoryEditorErrorTextBlock"
                                       Margin="0,6,0,0"
                                       Style="{StaticResource ErrorLineStyle}"
                                       AutomationProperties.LiveSetting="Assertive" />
                            <StackPanel Margin="0,8,0,0"
                                        HorizontalAlignment="Right"
                                        Orientation="Horizontal">
                                <Button MinWidth="64"
                                        Padding="10,5"
                                        Click="CategoryEditorCancelButton_Click"
                                        Content="Cancel"
                                        AutomationProperties.Name="Cancel category name" />
                                <Button x:Name="CategoryEditorConfirmButton"
                                        Margin="8,0,0,0"
                                        MinWidth="64"
                                        Padding="10,5"
                                        Click="CategoryEditorConfirmButton_Click"
                                        Content="Create"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        AutomationProperties.Name="Confirm category name" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="SidebarHintTextBlock"
                               DockPanel.Dock="Bottom"
                               Margin="4,10,4,0"
                               Style="{StaticResource MutedTextStyle}"
                               Text="Drag sounds or files onto a category to file them there." />

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ListBox x:Name="LibraryViewsListBox"
                                 SelectionChanged="LibraryViewsListBox_SelectionChanged"
                                 AutomationProperties.Name="Library views and categories">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem"
                                       BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="AutomationProperties.Name"
                                            Value="{Binding AutomationName}" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <!-- Divider that separates built-in views from user categories. -->
                                        <StackPanel x:Name="SectionHeader"
                                                    Margin="0,8,0,2"
                                                    Visibility="Collapsed">
                                            <Border Height="1"
                                                    Margin="2,0,2,6"
                                                    Background="{StaticResource BorderBrush}" />
                                            <TextBlock Margin="4,0,0,4"
                                                       Style="{StaticResource SectionHeadingTextStyle}"
                                                       Text="CATEGORIES" />
                                        </StackPanel>
                                        <Border x:Name="ViewItemRoot"
                                                AllowDrop="True"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource ControlCornerRadius}"
                                                ContextMenuOpening="LibraryViewItem_ContextMenuOpening"
                                                DragEnter="LibraryViewItem_DragOver"
                                                DragLeave="LibraryViewItem_DragLeave"
                                                DragOver="LibraryViewItem_DragOver"
                                                Drop="LibraryViewItem_Drop"
                                                SnapsToDevicePixels="True"
                                                Tag="{Binding}">
                                            <Border.ContextMenu>
                                                <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Header="Rename category"
                                                              Click="RenameCategoryMenuItem_Click"
                                                              Tag="{Binding}"
                                                              AutomationProperties.Name="Rename this category" />
                                                    <MenuItem Header="Move category earlier"
                                                              Click="MoveCategoryEarlierMenuItem_Click"
                                                              Tag="{Binding}"
                                                              AutomationProperties.Name="Move this category earlier" />
                                                    <MenuItem Header="Move category later"
                                                              Click="MoveCategoryLaterMenuItem_Click"
                                                              Tag="{Binding}"
                                                              AutomationProperties.Name="Move this category later" />
                                                    <Separator />
                                                    <MenuItem Header="Delete category…"
                                                              Click="DeleteCategoryMenuItem_Click"
                                                              Tag="{Binding}"
                                                              AutomationProperties.Name="Delete this category" />
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <Grid Height="32">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="26" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="ViewGlyph"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontFamily="{StaticResource IconFontFamily}"
                                                           FontSize="13"
                                                           Text="&#xE8B7;" />
                                                <TextBlock Grid.Column="1"
                                                           Margin="8,0,6,0"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding DisplayName}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding DisplayName}" />
                                                <Border x:Name="CountBadge"
                                                        Grid.Column="2"
                                                        Margin="0,0,6,0"
                                                        Padding="7,1"
                                                        VerticalAlignment="Center"
                                                        Background="{StaticResource SurfaceRaisedBackgroundBrush}"
                                                        CornerRadius="{StaticResource PillCornerRadius}"
                                                        Visibility="{Binding SidebarCountVisibility, RelativeSource={RelativeSource AncestorType=Window}}">
                                                    <TextBlock FontSize="{StaticResource FontSizeMicro}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               Text="{Binding SoundCountText}" />
                                                </Border>
                                                <Border x:Name="DropHintBadge"
                                                        Grid.Column="2"
                                                        Margin="0,0,6,0"
                                                        Padding="8,1"
                                                        VerticalAlignment="Center"
                                                        Background="{StaticResource AccentBrush}"
                                                        CornerRadius="{StaticResource PillCornerRadius}"
                                                        Visibility="Collapsed">
                                                    <TextBlock FontSize="{StaticResource FontSizeMicro}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextOnAccentBrush}"
                                                               Text="Move here" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Kind}" Value="AllSounds">
                                            <Setter TargetName="ViewGlyph" Property="Text" Value="&#xE767;" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="Favorites">
                                            <Setter TargetName="ViewGlyph" Property="Text" Value="&#xE735;" />
                                            <Setter TargetName="ViewGlyph" Property="Foreground" Value="{StaticResource WarningBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="Uncategorized">
                                            <Setter TargetName="ViewGlyph" Property="Text" Value="&#xE7C3;" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StartsUserCategorySection}" Value="True">
                                            <Setter TargetName="SectionHeader" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                            <Setter TargetName="ViewItemRoot" Property="Background" Value="{StaticResource AccentSubtleBrush}" />
                                            <Setter TargetName="ViewItemRoot" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            <Setter TargetName="CountBadge" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="DropHintBadge" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Soundboard -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Padding="18,12,18,10"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center"
                                    Orientation="Horizontal">
                            <TextBlock x:Name="SelectedViewTextBlock"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource TitleTextStyle}"
                                       Text="All Sounds" />
                            <TextBlock x:Name="SoundCountTextBlock"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource MutedTextStyle}"
                                       Text="0 sounds" />
                            <ToggleButton x:Name="OrganizeToggleButton"
                                          Margin="14,0,0,0"
                                          Padding="10,5"
                                          Checked="OrganizeToggleButton_Checked"
                                          Unchecked="OrganizeToggleButton_Unchecked"
                                          Style="{StaticResource SecondaryButtonStyle}"
                                          ToolTip="Select several sounds to move or favorite them together"
                                          AutomationProperties.Name="Organize sounds">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="0,0,6,0"
                                               VerticalAlignment="Center"
                                               FontFamily="{StaticResource IconFontFamily}"
                                               FontSize="12"
                                               Text="&#xE762;" />
                                    <TextBlock VerticalAlignment="Center"
                                               Text="Organize" />
                                </StackPanel>
                            </ToggleButton>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal">
                            <Border Width="230"
                                    Style="{StaticResource SearchContainerStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               FontFamily="{StaticResource IconFontFamily}"
                                               FontSize="12"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Text="&#xE721;" />
                                    <!--
                                        Decorative watermark. Its accessible name
                                        must differ from the TextBox's, otherwise
                                        assistive tools and automation resolve this
                                        static text instead of the input field.
                                    -->
                                    <TextBlock Grid.Column="1"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               IsHitTestVisible="False"
                                               Text="Search sounds"
                                               AutomationProperties.Name="Search box is empty">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=SearchTextBox}"
                                                                 Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBox x:Name="SearchTextBox"
                                             Grid.Column="1"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             TextChanged="SearchTextBox_TextChanged"
                                             ToolTip="Search by sound name, original filename, or category"
                                             AutomationProperties.Name="Search sounds by name, filename, or category" />
                                </Grid>
                            </Border>

                            <Button x:Name="ImportSoundsButton"
                                    Margin="10,0,0,0"
                                    Click="ImportSoundsButton_Click"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    ToolTip="Import WAV, MP3, Ogg Opus, or Ogg Vorbis files"
                                    AutomationProperties.Name="Import sounds">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="0,0,7,0"
                                               VerticalAlignment="Center"
                                               FontFamily="{StaticResource IconFontFamily}"
                                               FontSize="12"
                                               Text="&#xE8E5;" />
                                    <TextBlock x:Name="ImportButtonTextBlock"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold"
                                               Text="Import" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <TextBlock x:Name="ReorderHelpTextBlock"
                                   Grid.Row="1"
                                   Grid.ColumnSpan="2"
                                   Margin="0,8,0,0"
                                   Style="{StaticResource MutedTextStyle}"
                                   Text="Drag a tile onto a category to file it, or drag the handle to reorder." />
                    </Grid>
                </Border>

                <!--
                    Contextual command bar. It only exists while sounds are
                    selected, and every command it offers also has a keyboard
                    route through the tile context menu.
                -->
                <Border x:Name="SelectionCommandBar"
                        Grid.Row="1"
                        Padding="18,8"
                        Background="{StaticResource AccentSubtleBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="SelectionCountTextBlock"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="0 sounds selected"
                                   AutomationProperties.LiveSetting="Polite" />

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal">
                            <Button x:Name="MoveSelectionButton"
                                    Padding="12,6"
                                    Click="MoveSelectionButton_Click"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    ToolTip="Move every selected sound into one category"
                                    AutomationProperties.Name="Move selected sounds to a category">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="0,0,7,0"
                                               VerticalAlignment="Center"
                                               FontFamily="{StaticResource IconFontFamily}"
                                               FontSize="12"
                                               Text="&#xE8DE;" />
                                    <TextBlock VerticalAlignment="Center"
                                               Text="Move to category" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="FavoriteSelectionButton"
                                    Margin="8,0,0,0"
                                    Padding="12,6"
                                    Click="FavoriteSelectionButton_Click"
                                    Content="Add to favorites"
                                    ToolTip="Mark every selected sound as a favorite"
                                    AutomationProperties.Name="Add selected sounds to favorites" />
                            <Button x:Name="UnfavoriteSelectionButton"
                                    Margin="8,0,0,0"
                                    Padding="12,6"
                                    Click="UnfavoriteSelectionButton_Click"
                                    Content="Remove from favorites"
                                    ToolTip="Clear the favorite flag on every selected sound"
                                    AutomationProperties.Name="Remove selected sounds from favorites" />
                            <Button x:Name="SelectAllButton"
                                    Margin="8,0,0,0"
                                    Padding="12,6"
                                    Click="SelectAllButton_Click"
                                    Content="Select all"
                                    ToolTip="Select every sound in this view (Ctrl+A)"
                                    AutomationProperties.Name="Select all visible sounds" />
                            <Button x:Name="CancelSelectionButton"
                                    Margin="8,0,0,0"
                                    Padding="12,6"
                                    Click="CancelSelectionButton_Click"
                                    Content="Cancel"
                                    ToolTip="Leave organization mode (Escape)"
                                    AutomationProperties.Name="Cancel selection" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="SoundboardDropArea"
                        Grid.Row="2"
                        AllowDrop="True"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="2"
                        Drop="SoundboardDropArea_Drop"
                        DragLeave="SoundboardDropArea_DragLeave"
                        PreviewDragOver="SoundboardDropArea_PreviewDragOver">
                    <Grid>

                        <!-- Empty / no-match state -->
                        <StackPanel x:Name="EmptyStatePanel"
                                    MaxWidth="440"
                                    Margin="24"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <Border Width="56"
                                    Height="56"
                                    HorizontalAlignment="Center"
                                    Background="{StaticResource SurfaceBackgroundBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="16">
                                <TextBlock x:Name="EmptyStateGlyph"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource IconFontFamily}"
                                           FontSize="22"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Text="&#xE767;" />
                            </Border>
                            <TextBlock x:Name="EmptyStateTitleTextBlock"
                                       Margin="0,16,0,0"
                                       HorizontalAlignment="Center"
                                       Style="{StaticResource TitleTextStyle}"
                                       Text="No sounds yet"
                                       TextAlignment="Center" />
                            <TextBlock x:Name="EmptyStateMessageTextBlock"
                                       Margin="0,7,0,0"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       Text="Import a few clips to get started."
                                       TextAlignment="Center" />
                            <Button x:Name="EmptyStateActionButton"
                                    Margin="0,18,0,0"
                                    HorizontalAlignment="Center"
                                    Click="EmptyStateActionButton_Click"
                                    Content="Import Sounds"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                            <TextBlock x:Name="EmptyStateFormatsTextBlock"
                                       Margin="0,16,0,0"
                                       Style="{StaticResource MutedTextStyle}"
                                       Text="Supported formats: WAV, MP3, Ogg Opus, Ogg Vorbis, .opus — or drag files anywhere onto this area."
                                       TextAlignment="Center" />
                        </StackPanel>

                        <!-- Sound grid -->
                        <ScrollViewer x:Name="SoundGridScrollViewer"
                                      Padding="14,12,8,12"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="SoundTilesItemsControl"
                                          AutomationProperties.Name="Sound tiles">
                                <ItemsControl.ItemContainerStyle>
                                    <!-- Without this the container announces the view model's type name. -->
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="AutomationProperties.Name"
                                                Value="{Binding TileAutomationName}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="TileBorder"
                                                Width="188"
                                                Height="116"
                                                Margin="0,0,10,10"
                                                AllowDrop="True"
                                                Background="{StaticResource TileBackgroundBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource SurfaceCornerRadius}"
                                                DragLeave="SoundTile_DragLeave"
                                                DragOver="SoundTile_DragOver"
                                                Drop="SoundTile_Drop"
                                                PreviewMouseLeftButtonDown="SoundTile_PreviewMouseLeftButtonDown"
                                                PreviewMouseMove="SoundTile_PreviewMouseMove"
                                                SnapsToDevicePixels="True"
                                                Tag="{Binding}">
                                            <Border.ToolTip>
                                                <ToolTip>
                                                    <StackPanel MaxWidth="300">
                                                        <TextBlock FontWeight="SemiBold"
                                                                   Text="{Binding DisplayName}"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Margin="0,3,0,0"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   Text="{Binding TileDetailText}"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </ToolTip>
                                            </Border.ToolTip>
                                            <Border.ContextMenu>
                                                <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem x:Name="MoveToCategoryMenuItem"
                                                              Header="Move to"
                                                              SubmenuOpened="MoveToCategoryMenuItem_SubmenuOpened"
                                                              Tag="{Binding}"
                                                              AutomationProperties.Name="Move this sound to a category">
                                                        <MenuItem Header="Loading…" IsEnabled="False" />
                                                    </MenuItem>
                                                    <MenuItem Header="{Binding FavoriteActionText}"
                                                              Click="FavoriteTileButton_Click"
                                                              Tag="{Binding}"
                                                              AutomationProperties.Name="{Binding FavoriteActionText}" />
                                                    <Separator />
                                                    <MenuItem Header="Edit sound…"
                                                              Click="EditTileButton_Click"
                                                              Tag="{Binding}"
                                                              AutomationProperties.Name="Edit sound metadata" />
                                                    <MenuItem Header="Edit clip…"
                                                              Click="EditClipTileButton_Click"
                                                              Tag="{Binding}"
                                                              AutomationProperties.Name="Edit sound clip" />
                                                    <MenuItem Header="Assign hotkey…"
                                                              Click="AssignTileHotkeyButton_Click"
                                                              Tag="{Binding}"
                                                              AutomationProperties.Name="Assign or change sound hotkey" />
                                                    <Separator />
                                                    <MenuItem Header="Select this sound"
                                                              Click="SelectTileMenuItem_Click"
                                                              Tag="{Binding}"
                                                              AutomationProperties.Name="Select this sound for organization" />
                                                    <MenuItem Header="Move earlier"
                                                              IsEnabled="{Binding CanReorder}"
                                                              Click="MoveSoundEarlierMenuItem_Click"
                                                              Tag="{Binding}"
                                                              AutomationProperties.Name="Move sound earlier" />
                                                    <MenuItem Header="Move later"
                                                              IsEnabled="{Binding CanReorder}"
                                                              Click="MoveSoundLaterMenuItem_Click"
                                                              Tag="{Binding}"
                                                              AutomationProperties.Name="Move sound later" />
                                                    <Separator />
                                                    <MenuItem Header="Remove sound…"
                                                              Click="RemoveTileButton_Click"
                                                              Tag="{Binding}"
                                                              AutomationProperties.Name="Remove sound" />
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="3" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>

                                                <Border x:Name="AccentSource"
                                                        Style="{StaticResource TileAccentStripStyle}"
                                                        CornerRadius="9,9,0,0" />

                                                <Grid Grid.Row="1">

                                                    <!-- Primary surface: play / restart, or select while organizing -->
                                                    <Button x:Name="PlaySurface"
                                                            Click="PlayTileButton_Click"
                                                            Style="{StaticResource TileSurfaceButtonStyle}"
                                                            Tag="{Binding}"
                                                            AutomationProperties.Name="{Binding TileAutomationName}"
                                                            AutomationProperties.HelpText="{Binding PrimaryActionHelpText}">
                                                        <Grid Margin="10,8,10,8">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="28" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="*" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>

                                                            <Grid Width="28"
                                                                  Height="28"
                                                                  HorizontalAlignment="Left">
                                                                <Border x:Name="IconSurface"
                                                                        Background="{Binding Background, ElementName=AccentSource}"
                                                                        CornerRadius="9"
                                                                        Opacity="0.22" />
                                                                <TextBlock x:Name="PlayGlyph"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           FontFamily="{StaticResource IconFontFamily}"
                                                                           FontSize="13"
                                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                                           Text="&#xE768;" />
                                                                <Border x:Name="SelectionIndicator"
                                                                        Background="{StaticResource SurfaceRaisedBackgroundBrush}"
                                                                        BorderBrush="{StaticResource BorderStrongBrush}"
                                                                        BorderThickness="1"
                                                                        CornerRadius="9"
                                                                        SnapsToDevicePixels="True"
                                                                        Visibility="Collapsed">
                                                                    <TextBlock x:Name="SelectionGlyph"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"
                                                                               FontFamily="{StaticResource IconFontFamily}"
                                                                               FontSize="12"
                                                                               Foreground="{StaticResource TextOnAccentBrush}"
                                                                               Text="&#xE73E;"
                                                                               Visibility="Collapsed" />
                                                                </Border>
                                                            </Grid>

                                                            <TextBlock Grid.Row="1"
                                                                       Margin="0,8,0,0"
                                                                       FontSize="{StaticResource FontSizeBody}"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                                       Text="{Binding DisplayName}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       TextWrapping="NoWrap" />

                                                            <TextBlock Grid.Row="2"
                                                                       Margin="0,2,0,0"
                                                                       FontSize="{StaticResource FontSizeMicro}"
                                                                       Foreground="{StaticResource TextMutedBrush}"
                                                                       Text="{Binding MetaText}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       TextWrapping="NoWrap" />

                                                            <StackPanel Grid.Row="4"
                                                                        ClipToBounds="True"
                                                                        Orientation="Horizontal">
                                                                <Border Style="{StaticResource TileChipStyle}"
                                                                        Visibility="{Binding HasHotkey, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                    <TextBlock MaxWidth="86"
                                                                               Style="{StaticResource TileChipTextStyle}"
                                                                               Text="{Binding HotkeyDisplayText}"
                                                                               ToolTip="{Binding HotkeyStateText}" />
                                                                </Border>
                                                                <Border Style="{StaticResource TileChipStyle}"
                                                                        Visibility="{Binding ShowCategoryChip, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Margin="0,0,4,0"
                                                                                   VerticalAlignment="Center"
                                                                                   FontFamily="{StaticResource IconFontFamily}"
                                                                                   FontSize="9"
                                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                                   Text="&#xE8B7;" />
                                                                        <TextBlock MaxWidth="78"
                                                                                   Style="{StaticResource TileChipTextStyle}"
                                                                                   Text="{Binding CategoryName}"
                                                                                   ToolTip="{Binding CategoryChipAutomationName}" />
                                                                    </StackPanel>
                                                                </Border>
                                                                <Border Style="{StaticResource TileChipStyle}"
                                                                        Visibility="{Binding HasClipEdits, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                    <TextBlock Style="{StaticResource TileChipTextStyle}"
                                                                               Text="{Binding EditedStateText}"
                                                                               ToolTip="This sound has trim or fade edits" />
                                                                </Border>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Button>

                                                    <!--
                                                        Secondary actions sit above the play surface as
                                                        siblings, never nested inside it, so a click on
                                                        one can never fall through to playback.
                                                    -->
                                                    <StackPanel x:Name="TileActions"
                                                                Margin="0,6,6,0"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Top"
                                                                Orientation="Horizontal"
                                                                Panel.ZIndex="1"
                                                                Visibility="Collapsed">
                                                        <Button x:Name="DragHandle"
                                                                Content="&#xE700;"
                                                                PreviewMouseLeftButtonDown="SoundDragHandle_PreviewMouseLeftButtonDown"
                                                                PreviewMouseMove="SoundDragHandle_PreviewMouseMove"
                                                                Style="{StaticResource TileActionButtonStyle}"
                                                                Tag="{Binding}"
                                                                ToolTip="{Binding ReorderAvailabilityText}"
                                                                AutomationProperties.Name="Drag to reorder or to move into a category" />
                                                        <Button x:Name="FavoriteButton"
                                                                Click="FavoriteTileButton_Click"
                                                                Content="&#xE734;"
                                                                Style="{StaticResource TileActionButtonStyle}"
                                                                Tag="{Binding}"
                                                                ToolTip="{Binding FavoriteActionText}"
                                                                AutomationProperties.Name="{Binding FavoriteActionText}" />
                                                        <Button x:Name="OverflowButton"
                                                                Click="SoundOverflowButton_Click"
                                                                Content="&#xE712;"
                                                                Style="{StaticResource TileActionButtonStyle}"
                                                                Tag="{Binding}"
                                                                ToolTip="More actions — move to a category, edit, hotkey, remove"
                                                                AutomationProperties.Name="{Binding DisplayName, StringFormat=More actions for {0}}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </Border>

                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                <Setter TargetName="TileBorder"
                                                        Property="BorderBrush"
                                                        Value="{StaticResource PlayingBrush}" />
                                                <Setter TargetName="TileBorder"
                                                        Property="Background"
                                                        Value="{StaticResource PlayingSubtleBrush}" />
                                                <Setter TargetName="PlayGlyph"
                                                        Property="Text"
                                                        Value="&#xE72C;" />
                                                <Setter TargetName="PlayGlyph"
                                                        Property="Foreground"
                                                        Value="{StaticResource PlayingBrush}" />
                                                <Setter TargetName="IconSurface"
                                                        Property="Opacity"
                                                        Value="0.4" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                <Setter TargetName="FavoriteButton"
                                                        Property="Content"
                                                        Value="&#xE735;" />
                                                <Setter TargetName="FavoriteButton"
                                                        Property="Foreground"
                                                        Value="{StaticResource WarningBrush}" />
                                                <Setter TargetName="TileActions"
                                                        Property="Visibility"
                                                        Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSelectionMode}" Value="True">
                                                <Setter TargetName="SelectionIndicator"
                                                        Property="Visibility"
                                                        Value="Visible" />
                                                <Setter TargetName="DragHandle"
                                                        Property="IsEnabled"
                                                        Value="False" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="TileBorder"
                                                        Property="BorderBrush"
                                                        Value="{StaticResource AccentBrush}" />
                                                <Setter TargetName="TileBorder"
                                                        Property="Background"
                                                        Value="{StaticResource AccentSubtleBrush}" />
                                                <Setter TargetName="SelectionIndicator"
                                                        Property="Background"
                                                        Value="{StaticResource AccentBrush}" />
                                                <Setter TargetName="SelectionIndicator"
                                                        Property="BorderBrush"
                                                        Value="{StaticResource AccentBrush}" />
                                                <Setter TargetName="SelectionGlyph"
                                                        Property="Visibility"
                                                        Value="Visible" />
                                            </DataTrigger>
                                            <Trigger SourceName="TileBorder"
                                                     Property="IsMouseOver"
                                                     Value="True">
                                                <Setter TargetName="TileActions"
                                                        Property="Visibility"
                                                        Value="Visible" />
                                            </Trigger>
                                            <Trigger SourceName="TileBorder"
                                                     Property="IsKeyboardFocusWithin"
                                                     Value="True">
                                                <Setter TargetName="TileActions"
                                                        Property="Visibility"
                                                        Value="Visible" />
                                            </Trigger>
                                            <Trigger SourceName="PlaySurface"
                                                     Property="IsMouseOver"
                                                     Value="True">
                                                <Setter TargetName="TileBorder"
                                                        Property="Background"
                                                        Value="{StaticResource TileHoverBackgroundBrush}" />
                                                <Setter TargetName="TileBorder"
                                                        Property="BorderBrush"
                                                        Value="{StaticResource BorderStrongBrush}" />
                                            </Trigger>
                                            <Trigger SourceName="PlaySurface"
                                                     Property="IsPressed"
                                                     Value="True">
                                                <Setter TargetName="TileBorder"
                                                        Property="Background"
                                                        Value="{StaticResource TilePressedBackgroundBrush}" />
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!--
                            Undo strip for the most recent category move. It
                            floats over the grid so a move never pushes the
                            tiles the user is still working with.
                        -->
                        <Border x:Name="UndoNotificationBar"
                                Margin="18"
                                Padding="14,9"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Background="{StaticResource SurfaceRaisedBackgroundBrush}"
                                BorderBrush="{StaticResource BorderStrongBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource ControlCornerRadius}"
                                SnapsToDevicePixels="True"
                                Visibility="Collapsed">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16"
                                                  Direction="270"
                                                  Opacity="0.45"
                                                  ShadowDepth="3"
                                                  Color="#FF05070B" />
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,10,0"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource IconFontFamily}"
                                           FontSize="13"
                                           Foreground="{StaticResource SuccessBrush}"
                                           Text="&#xE73E;" />
                                <TextBlock x:Name="UndoNotificationTextBlock"
                                           MaxWidth="360"
                                           VerticalAlignment="Center"
                                           Text="Moved to Songs"
                                           TextTrimming="CharacterEllipsis"
                                           AutomationProperties.LiveSetting="Polite" />
                                <Button x:Name="UndoActionButton"
                                        Margin="14,0,0,0"
                                        Padding="12,5"
                                        Click="UndoActionButton_Click"
                                        Content="Undo"
                                        ToolTip="Put the moved sounds back where they were"
                                        AutomationProperties.Name="Undo the last move" />
                                <Button x:Name="DismissUndoButton"
                                        Margin="6,0,0,0"
                                        Width="28"
                                        Height="28"
                                        Click="DismissUndoButton_Click"
                                        Content="&#xE711;"
                                        Style="{StaticResource IconButtonStyle}"
                                        ToolTip="Dismiss"
                                        AutomationProperties.Name="Dismiss this notification" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ==================== Status bar ==================== -->
        <Border Grid.Row="2"
                Padding="18,9"
                Background="{StaticResource SidebarBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <TextBlock Margin="0,0,7,0"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource IconFontFamily}"
                               FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}"
                               Text="&#xE768;" />
                    <TextBlock x:Name="CurrentSoundTextBlock"
                               VerticalAlignment="Center"
                               Style="{StaticResource CaptionTextStyle}"
                               Text="No sound playing"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"
                               AutomationProperties.LiveSetting="Polite" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Border Style="{StaticResource StatusChipStyle}">
                        <TextBlock x:Name="HotkeyActionTextBlock"
                                   MaxWidth="220"
                                   Style="{StaticResource MutedTextStyle}"
                                   Text="Hotkey: none"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   ToolTip="Most recent global-hotkey action" />
                    </Border>
                    <Border Style="{StaticResource StatusChipStyle}">
                        <TextBlock x:Name="MonitoringStatusTextBlock"
                                   Style="{StaticResource MutedTextStyle}"
                                   Text="Monitor: off"
                                   TextWrapping="NoWrap"
                                   ToolTip="Headphone monitoring state" />
                    </Border>
                    <TextBlock Margin="4,0,7,0"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource IconFontFamily}"
                               FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}"
                               Text="&#xE767;" />
                    <Slider x:Name="SoundVolumeSlider"
                            Width="110"
                            VerticalAlignment="Center"
                            Minimum="0"
                            Maximum="200"
                            Value="100"
                            TickFrequency="10"
                            ToolTip="Soundboard volume"
                            AutomationProperties.Name="Sound volume percent" />
                    <TextBlock x:Name="SoundVolumeTextBlock"
                               Width="42"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource MutedTextStyle}"
                               Text="100%"
                               TextAlignment="Right"
                               TextWrapping="NoWrap" />
                </StackPanel>

                <StackPanel Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Margin="0,6,0,0">
                    <TextBlock x:Name="StatusTextBlock"
                               Style="{StaticResource MutedTextStyle}"
                               Text="Ready."
                               AutomationProperties.LiveSetting="Polite" />
                    <TextBlock x:Name="ErrorTextBlock"
                               Margin="0,3,0,0"
                               Style="{StaticResource ErrorLineStyle}"
                               AutomationProperties.LiveSetting="Assertive" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
