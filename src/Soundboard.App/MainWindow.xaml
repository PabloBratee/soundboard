<Window x:Class="Soundboard.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Soundboard"
        Width="820"
        Height="900"
        MinWidth="680"
        MinHeight="650"
        WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock FontSize="28"
                       FontWeight="SemiBold"
                       Text="Soundboard" />

            <TextBlock Margin="0,8,0,18"
                       Foreground="#555555"
                       Text="Microphone and single-file mixing proof of concept"
                       TextWrapping="Wrap" />

            <Border Margin="0,0,0,16"
                    Padding="12"
                    Background="#F3F6FA"
                    BorderBrush="#C8D1DC"
                    BorderThickness="1"
                    CornerRadius="4">
                <TextBlock FontFamily="Consolas"
                           TextWrapping="Wrap">
                    <Run Text="Physical microphone ─┐&#10;" />
                    <Run Text="                     ├─ Soundboard mixer → CABLE Input&#10;" />
                    <Run Text="Selected sound file ─┘&#10;&#10;" />
                    <Run Text="CABLE Output → Discord or game microphone" />
                </TextBlock>
            </Border>

            <GroupBox Margin="0,0,0,14" Header="Audio devices">
                <StackPanel Margin="10">
                    <Label Padding="0,0,0,6"
                           FontWeight="SemiBold"
                           Content="Microphone (active capture endpoint)" />
                    <ComboBox x:Name="MicrophoneComboBox"
                              MinHeight="32"
                              DisplayMemberPath="FriendlyName"
                              IsTextSearchEnabled="True" />

                    <Label Margin="0,12,0,0"
                           Padding="0,0,0,6"
                           FontWeight="SemiBold"
                           Content="Virtual output (active render endpoint)" />
                    <ComboBox x:Name="VirtualOutputComboBox"
                              MinHeight="32"
                              DisplayMemberPath="FriendlyName"
                              IsTextSearchEnabled="True" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="RefreshDevicesButton"
                                MinWidth="125"
                                Padding="12,7"
                                Click="RefreshDevicesButton_Click"
                                Content="Refresh devices" />

                        <TextBlock x:Name="DeviceCountsTextBlock"
                                   Grid.Column="1"
                                   Margin="16,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="#444444"
                                   Text="Waiting for device discovery…" />
                    </Grid>

                    <Border Margin="0,12,0,0"
                            Padding="10"
                            Background="#FFF4D6"
                            BorderBrush="#E6C66A"
                            BorderThickness="1"
                            CornerRadius="4">
                        <TextBlock x:Name="VirtualCableStatusTextBlock"
                                   FontWeight="SemiBold"
                                   Text="Checking for VB-CABLE endpoints…"
                                   TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </GroupBox>

            <GroupBox Margin="0,0,0,14" Header="Audio engine">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="StartEngineButton"
                            MinWidth="145"
                            Padding="12,7"
                            Click="StartEngineButton_Click"
                            Content="Start audio engine" />

                    <Button x:Name="StopEngineButton"
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            MinWidth="145"
                            Padding="12,7"
                            Click="StopEngineButton_Click"
                            Content="Stop audio engine" />

                    <StackPanel Grid.Column="2"
                                Margin="18,0,0,0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <TextBlock FontWeight="SemiBold" Text="State: " />
                        <TextBlock x:Name="EngineStateTextBlock"
                                   Text="Stopped" />
                    </StackPanel>
                </Grid>
            </GroupBox>

            <GroupBox Margin="0,0,0,14" Header="Microphone">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="145" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>

                    <TextBlock VerticalAlignment="Center"
                               Text="Volume" />
                    <Slider x:Name="MicrophoneVolumeSlider"
                            Grid.Column="1"
                            Minimum="0"
                            Maximum="200"
                            Value="100"
                            TickFrequency="10" />
                    <TextBlock x:Name="MicrophoneVolumeTextBlock"
                               Grid.Column="2"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Text="100%" />

                    <CheckBox x:Name="MuteMicrophoneCheckBox"
                              Grid.Row="1"
                              Margin="0,12,0,0"
                              VerticalAlignment="Center"
                              Content="Mute microphone" />
                    <ProgressBar x:Name="MicrophonePeakProgressBar"
                                 Grid.Row="1"
                                 Grid.Column="1"
                                 Margin="0,12,0,0"
                                 Height="16"
                                 Maximum="1" />
                    <TextBlock x:Name="MicrophonePeakTextBlock"
                               Grid.Row="1"
                               Grid.Column="2"
                               Margin="10,12,0,0"
                               VerticalAlignment="Center"
                               Text="0%" />
                </Grid>
            </GroupBox>

            <GroupBox Margin="0,0,0,14" Header="Sound file">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="145" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="ChooseSoundFileButton"
                            MinWidth="135"
                            Padding="10,6"
                            Click="ChooseSoundFileButton_Click"
                            Content="Choose sound file" />
                    <TextBlock x:Name="SelectedSoundFileTextBlock"
                               Grid.Column="1"
                               Grid.ColumnSpan="2"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="#555555"
                               Text="No WAV or MP3 selected"
                               TextTrimming="CharacterEllipsis" />

                    <TextBlock Grid.Row="1"
                               Margin="0,12,0,0"
                               VerticalAlignment="Center"
                               Text="Volume" />
                    <Slider x:Name="SoundVolumeSlider"
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="0,12,0,0"
                            Minimum="0"
                            Maximum="200"
                            Value="100"
                            TickFrequency="10" />
                    <TextBlock x:Name="SoundVolumeTextBlock"
                               Grid.Row="1"
                               Grid.Column="2"
                               Margin="10,12,0,0"
                               VerticalAlignment="Center"
                               Text="100%" />

                    <StackPanel Grid.Row="2"
                                Grid.ColumnSpan="3"
                                Margin="0,12,0,0"
                                Orientation="Horizontal">
                        <Button x:Name="PlaySoundButton"
                                MinWidth="110"
                                Padding="10,6"
                                Click="PlaySoundButton_Click"
                                Content="Play sound" />
                        <Button x:Name="StopSoundButton"
                                Margin="10,0,0,0"
                                MinWidth="110"
                                Padding="10,6"
                                Click="StopSoundButton_Click"
                                Content="Stop sound" />
                    </StackPanel>
                </Grid>
            </GroupBox>

            <GroupBox Margin="0,0,0,14" Header="Mixed output">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="145" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>

                    <TextBlock VerticalAlignment="Center"
                               Text="Final output peak" />
                    <ProgressBar x:Name="OutputPeakProgressBar"
                                 Grid.Column="1"
                                 Height="16"
                                 Maximum="1" />
                    <TextBlock x:Name="OutputPeakTextBlock"
                               Grid.Column="2"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Text="0%" />

                    <TextBlock Grid.Row="1"
                               Margin="0,12,0,0"
                               VerticalAlignment="Top"
                               Text="Target format" />
                    <TextBlock x:Name="TargetFormatTextBlock"
                               Grid.Row="1"
                               Grid.Column="1"
                               Grid.ColumnSpan="2"
                               Margin="0,12,0,0"
                               Text="Select a render endpoint."
                               TextWrapping="Wrap" />
                </Grid>
            </GroupBox>

            <Border Margin="0,0,0,14"
                    Padding="10"
                    Background="#F5F5F5"
                    BorderBrush="#D0D0D0"
                    BorderThickness="1"
                    CornerRadius="4">
                <StackPanel>
                    <TextBlock x:Name="StatusTextBlock"
                               FontWeight="SemiBold"
                               Text="Ready."
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="ErrorTextBlock"
                               Margin="0,6,0,0"
                               Foreground="DarkRed"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <GroupBox Header="Diagnostic status">
                <TextBox x:Name="DiagnosticStatusTextBox"
                         Height="260"
                         Margin="8"
                         Padding="8"
                         AcceptsReturn="True"
                         Background="#FAFAFA"
                         BorderThickness="0"
                         FontFamily="Consolas"
                         HorizontalScrollBarVisibility="Auto"
                         IsReadOnly="True"
                         Text="Device discovery has not run yet."
                         VerticalScrollBarVisibility="Auto" />
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</Window>
