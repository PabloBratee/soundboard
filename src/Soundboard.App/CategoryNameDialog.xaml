<Window x:Class="Soundboard.App.CategoryNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Category"
        Width="420"
        Height="185"
        MinWidth="360"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="PromptTextBlock"
                   FontWeight="SemiBold"
                   Text="Category name" />
        <TextBox x:Name="NameTextBox"
                 Grid.Row="1"
                 Margin="0,7,0,0"
                 MinHeight="30"
                 MaxLength="60"
                 VerticalContentAlignment="Center"
                 AutomationProperties.Name="Category name" />
        <StackPanel Grid.Row="2"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button MinWidth="88"
                    Padding="10,5"
                    IsCancel="True"
                    Click="CancelButton_Click"
                    Content="Cancel" />
            <Button x:Name="SaveButton"
                    Margin="9,0,0,0"
                    MinWidth="88"
                    Padding="10,5"
                    IsDefault="True"
                    Click="SaveButton_Click"
                    Content="Save" />
        </StackPanel>
    </Grid>
</Window>
