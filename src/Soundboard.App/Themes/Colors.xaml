<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Semantic dark palette. Views reference the brush keys below rather
        than literal colors so the whole application can be retuned here.
    -->

    <!-- Surfaces -->
    <Color x:Key="AppBackgroundColor">#FF0F1116</Color>
    <Color x:Key="SidebarBackgroundColor">#FF14171F</Color>
    <Color x:Key="SurfaceBackgroundColor">#FF191D27</Color>
    <Color x:Key="SurfaceRaisedBackgroundColor">#FF1F2430</Color>
    <Color x:Key="TileBackgroundColor">#FF1B2029</Color>
    <Color x:Key="TileHoverBackgroundColor">#FF262D3B</Color>
    <Color x:Key="TilePressedBackgroundColor">#FF313A4C</Color>

    <!-- Text -->
    <Color x:Key="TextPrimaryColor">#FFE8EAF0</Color>
    <Color x:Key="TextSecondaryColor">#FFA6AEBD</Color>
    <Color x:Key="TextMutedColor">#FF7C8698</Color>
    <Color x:Key="TextOnAccentColor">#FFFFFFFF</Color>

    <!-- Lines -->
    <Color x:Key="BorderColor">#FF2A3040</Color>
    <Color x:Key="BorderStrongColor">#FF3D4658</Color>

    <!-- Accent and status -->
    <Color x:Key="AccentColor">#FF6D5BE8</Color>
    <Color x:Key="AccentHoverColor">#FF8172F0</Color>
    <Color x:Key="AccentPressedColor">#FF5A48D2</Color>
    <Color x:Key="AccentSubtleColor">#FF262046</Color>
    <Color x:Key="SuccessColor">#FF48C68C</Color>
    <Color x:Key="WarningColor">#FFE3A63F</Color>
    <Color x:Key="ErrorColor">#FFE96F68</Color>
    <Color x:Key="PlayingColor">#FF3FC8D8</Color>
    <Color x:Key="PlayingSubtleColor">#FF10323A</Color>
    <Color x:Key="DisabledColor">#FF525A6C</Color>
    <Color x:Key="FocusColor">#FFA294FF</Color>

    <SolidColorBrush x:Key="AppBackgroundBrush"
                     Color="{StaticResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush"
                     Color="{StaticResource SidebarBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBackgroundBrush"
                     Color="{StaticResource SurfaceBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceRaisedBackgroundBrush"
                     Color="{StaticResource SurfaceRaisedBackgroundColor}" />
    <SolidColorBrush x:Key="TileBackgroundBrush"
                     Color="{StaticResource TileBackgroundColor}" />
    <SolidColorBrush x:Key="TileHoverBackgroundBrush"
                     Color="{StaticResource TileHoverBackgroundColor}" />
    <SolidColorBrush x:Key="TilePressedBackgroundBrush"
                     Color="{StaticResource TilePressedBackgroundColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush"
                     Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush"
                     Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush"
                     Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="TextOnAccentBrush"
                     Color="{StaticResource TextOnAccentColor}" />

    <SolidColorBrush x:Key="BorderBrush"
                     Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush"
                     Color="{StaticResource BorderStrongColor}" />

    <SolidColorBrush x:Key="AccentBrush"
                     Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush"
                     Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush"
                     Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="AccentSubtleBrush"
                     Color="{StaticResource AccentSubtleColor}" />
    <SolidColorBrush x:Key="SuccessBrush"
                     Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush"
                     Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="ErrorBrush"
                     Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="PlayingBrush"
                     Color="{StaticResource PlayingColor}" />
    <SolidColorBrush x:Key="PlayingSubtleBrush"
                     Color="{StaticResource PlayingSubtleColor}" />
    <SolidColorBrush x:Key="DisabledBrush"
                     Color="{StaticResource DisabledColor}" />
    <SolidColorBrush x:Key="FocusBrush"
                     Color="{StaticResource FocusColor}" />

    <!--
        Controlled per-tile accent presets. These mirror the existing
        SoundTileAccent values and are used for the accent strip and the
        tile icon surface only, never for the whole tile background.
    -->
    <SolidColorBrush x:Key="TileAccentDefaultBrush" Color="#FF5C6577" />
    <SolidColorBrush x:Key="TileAccentBlueBrush" Color="#FF4C8DF6" />
    <SolidColorBrush x:Key="TileAccentPurpleBrush" Color="#FF9A6CF0" />
    <SolidColorBrush x:Key="TileAccentGreenBrush" Color="#FF43BE85" />
    <SolidColorBrush x:Key="TileAccentOrangeBrush" Color="#FFE39247" />
    <SolidColorBrush x:Key="TileAccentRedBrush" Color="#FFE2635E" />
    <SolidColorBrush x:Key="TileAccentPinkBrush" Color="#FFE167B4" />
    <SolidColorBrush x:Key="TileAccentTealBrush" Color="#FF3BB8B4" />

</ResourceDictionary>
