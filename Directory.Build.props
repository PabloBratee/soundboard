<Project>
  <PropertyGroup>
    <Version Condition="'$(Version)' == ''">1.3.1</Version>
    <AssemblyVersion Condition="'$(AssemblyVersion)' == ''">1.3.1.0</AssemblyVersion>
    <FileVersion Condition="'$(FileVersion)' == ''">1.3.1.0</FileVersion>
    <InformationalVersion Condition="'$(InformationalVersion)' == ''">$(Version)</InformationalVersion>
    <Product>Soundboard</Product>
    <Authors>Pablo</Authors>
    <Company>Pablo</Company>
    <Description>Local Windows soundboard with virtual microphone mixing</Description>
    <Copyright>Copyright © 2026 Pablo</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
